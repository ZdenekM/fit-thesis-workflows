#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

expected_file="$(mktemp)"
trap 'rm -f "$expected_file"' EXIT

pants --tag=workflow-tool peek :: | python3 -c '
import json
import pathlib
import sys

tools = []
for target in json.load(sys.stdin):
    if target.get("target_type") != "pex_binary":
        continue
    address = target.get("address")
    output_path = target.get("output_path")
    if not isinstance(output_path, str):
        raise SystemExit(f"workflow-tool target {address} has no output_path")
    path = pathlib.PurePosixPath(output_path)
    if str(path.parent) != "workflow-tools/pex":
        raise SystemExit(
            f"workflow-tool target {address} must output under workflow-tools/pex/, got {output_path}"
        )
    tools.append(path.name)

if not tools:
    raise SystemExit("No workflow-tool pex_binary targets found.")

for tool in sorted(tools):
    print(tool)
' >"$expected_file"

mapfile -t expected_tools <"$expected_file"

echo "Packaging workflow tools into dist/workflow-tools/bin/"
rm -rf "$repo_root/dist/workflow-tools"
pants --tag=workflow-tool package ::

mkdir -p "$repo_root/dist/workflow-tools/bin"

declare -A expected_by_name=()
for tool_name in "${expected_tools[@]}"; do
  expected_by_name["$tool_name"]=1

  pex_dir="$repo_root/dist/workflow-tools/pex/$tool_name"
  if [[ ! -d "$pex_dir" ]]; then
    echo "Missing packed PEX directory: dist/workflow-tools/pex/$tool_name" >&2
    exit 1
  fi

  launcher="$repo_root/dist/workflow-tools/bin/$tool_name"
  cmd_launcher="$repo_root/dist/workflow-tools/bin/$tool_name.cmd"
  ps_launcher="$repo_root/dist/workflow-tools/bin/$tool_name.ps1"
  cat >"$launcher" <<EOF
#!/usr/bin/env bash
set -euo pipefail
script_dir="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="\$(cd "\$script_dir/../../.." && pwd -P)"
export THESIS_REVIEW_CALLER_CWD="\${THESIS_REVIEW_CALLER_CWD:-\$PWD}"
export PYTHONPATH=
export PEX_ROOT="\${PEX_ROOT:-\$repo_root/.pants.d/pex_root}"
python_bin="\${WORKFLOW_TOOLS_PYTHON:-}"
if [[ -z "\$python_bin" ]]; then
  if command -v python3.12 >/dev/null 2>&1; then
    python_bin="python3.12"
  else
    python_bin="python3"
  fi
fi
if ! "\$python_bin" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] == (3, 12) else 1)'; then
  echo "Workflow tool launchers require Python 3.12. Set WORKFLOW_TOOLS_PYTHON=/path/to/python3.12 if needed." >&2
  exit 1
fi
cd "\$repo_root"
exec "\$python_bin" "\$script_dir/../pex/$tool_name" "\$@"
EOF
  chmod +x "$launcher"

  cat >"$cmd_launcher" <<EOF
@echo off
setlocal
set "script_dir=%~dp0"
for %%I in ("%script_dir%..\..\..") do set "repo_root=%%~fI"
if not defined THESIS_REVIEW_CALLER_CWD set "THESIS_REVIEW_CALLER_CWD=%CD%"
set "PYTHONPATH="
if not defined PEX_ROOT set "PEX_ROOT=%repo_root%\.pants.d\pex_root"
set "pex_path=%script_dir%..\pex\\$tool_name"
if defined WORKFLOW_TOOLS_PYTHON goto use_env_python
py -3.12 -c "import sys; raise SystemExit(0 if sys.version_info[:2] == (3, 12) else 1)" >nul 2>nul
if not errorlevel 1 goto use_py_launcher
python -c "import sys; raise SystemExit(0 if sys.version_info[:2] == (3, 12) else 1)" >nul 2>nul
if not errorlevel 1 goto use_python_launcher
goto python_error

:use_env_python
"%WORKFLOW_TOOLS_PYTHON%" -c "import sys; raise SystemExit(0 if sys.version_info[:2] == (3, 12) else 1)" >nul 2>nul
if errorlevel 1 goto python_error
cd /d "%repo_root%" || exit /b 1
"%WORKFLOW_TOOLS_PYTHON%" "%pex_path%" %*
exit /b %ERRORLEVEL%

:use_py_launcher
cd /d "%repo_root%" || exit /b 1
py -3.12 "%pex_path%" %*
exit /b %ERRORLEVEL%

:use_python_launcher
cd /d "%repo_root%" || exit /b 1
python "%pex_path%" %*
exit /b %ERRORLEVEL%

:python_error
echo Workflow tool launchers require Python 3.12. Set WORKFLOW_TOOLS_PYTHON=C:\Path\To\python.exe if needed. 1>&2
exit /b 1
EOF

  cat >"$ps_launcher" <<EOF
\$ErrorActionPreference = "Stop"
\$scriptDir = Split-Path -Parent \$MyInvocation.MyCommand.Path
\$repoRoot = (Resolve-Path (Join-Path \$scriptDir "..\..\..")).Path
if (-not \$env:THESIS_REVIEW_CALLER_CWD) {
    \$env:THESIS_REVIEW_CALLER_CWD = (Get-Location).Path
}
\$env:PYTHONPATH = ""
if (-not \$env:PEX_ROOT) {
    \$env:PEX_ROOT = Join-Path \$repoRoot ".pants.d\pex_root"
}
\$pexPath = Join-Path \$scriptDir "..\pex\\$tool_name"
\$candidates = @()
if (\$env:WORKFLOW_TOOLS_PYTHON) {
    \$candidates += ,@(\$env:WORKFLOW_TOOLS_PYTHON)
} else {
    \$candidates += ,@("py", "-3.12")
    \$candidates += ,@("python")
}
\$pythonExe = \$null
\$pythonArgs = @()
foreach (\$candidate in \$candidates) {
    \$exe = \$candidate[0]
    \$baseArgs = @(\$candidate | Select-Object -Skip 1)
    if (-not (Get-Command \$exe -ErrorAction SilentlyContinue)) {
        continue
    }
    & \$exe @baseArgs -c "import sys; raise SystemExit(0 if sys.version_info[:2] == (3, 12) else 1)" *> \$null
    if (\$LASTEXITCODE -eq 0) {
        \$pythonExe = \$exe
        \$pythonArgs = \$baseArgs
        break
    }
}
if (-not \$pythonExe) {
    Write-Error "Workflow tool launchers require Python 3.12. Set WORKFLOW_TOOLS_PYTHON=C:\Path\To\python.exe if needed."
    exit 1
}
Set-Location \$repoRoot
& \$pythonExe @pythonArgs \$pexPath @args
exit \$LASTEXITCODE
EOF
done

for pex_dir in "$repo_root"/dist/workflow-tools/pex/*; do
  [[ -d "$pex_dir" ]] || continue
  tool_name="$(basename "$pex_dir")"
  if [[ -z "${expected_by_name[$tool_name]+x}" ]]; then
    echo "Unexpected packed PEX directory: dist/workflow-tools/pex/$tool_name" >&2
    exit 1
  fi
done

echo
echo "Packaged tools:"
find "$repo_root/dist/workflow-tools/bin" -maxdepth 1 -mindepth 1 -type f -printf '%f\n' | sort | sed 's#^#- dist/workflow-tools/bin/#'
echo "PEX_ROOT defaults to .pants.d/pex_root in the repository unless already set."
echo "Windows launchers are generated as .cmd and .ps1 next to the POSIX launchers."
