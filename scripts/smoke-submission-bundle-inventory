#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"
case_id="__smoke_submission_bundle_inventory__"
round_id="20260519-smoke"
case_dir="$repo_root/cases/$case_id"
round_dir="$case_dir/rounds/$round_id"

cleanup() {
  rm -rf "$case_dir"
}
trap cleanup EXIT
cleanup

mkdir -p "$round_dir/inputs"

python3 - "$round_dir/inputs/submission.zip" <<'PY'
import io
import sys
import zipfile

target = sys.argv[1]
buffer = io.BytesIO()
with zipfile.ZipFile(buffer, "w") as handle:
    handle.writestr("project/pyproject.toml", "[project]\nname = 'synthetic'\n")
    handle.writestr("project/src/main.py", "print('synthetic')\n")
with zipfile.ZipFile(target, "w") as handle:
    handle.writestr("Export/code.zip", buffer.getvalue())
    handle.writestr("Export/README.md", "# Synthetic\n")
    handle.writestr("Export/demo.mp4", b"placeholder")
PY

"$repo_root/scripts/inventory-submission-bundle" \
  "$case_id" \
  "$round_id" \
  --bundle inputs/submission.zip \
  --generated-at 2026-05-19T12:00:00Z >/tmp/submission-bundle-inventory-smoke.out

python3 - "$round_dir/work/submission_bundle_inventory.json" <<'PY'
import json
import sys

payload = json.loads(open(sys.argv[1], encoding="utf-8").read())
classes = {item["artifact_class"] for item in payload["candidates"]}
expected = {"code_archive_candidate", "readme_candidate", "media_artifact"}
missing = expected - classes
if missing:
    raise SystemExit(f"missing expected classes: {sorted(missing)}")
if payload["summary"]["candidate_count"] < 3:
    raise SystemExit("inventory did not record expected candidates")
PY

test -f "$round_dir/work/submission_bundle_inventory.md"
echo "submission bundle inventory smoke passed"
