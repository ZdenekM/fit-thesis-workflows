#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_id="__theses_report_smoke_$$"
round_id="round-a"
tmp_dir="$(mktemp -d)"
out_file="/tmp/theses-report-smoke.$$.out"
err_file="/tmp/theses-report-smoke.$$.err"

cleanup() {
  rm -f "$out_file" "$err_file"
  rm -rf "$tmp_dir"
  rm -rf "$repo_root/cases/$case_id"
}
trap cleanup EXIT

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift
  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    exit 1
  fi
}

expect_output() {
  local needle="$1"
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

make_pdf() {
  local target="$1"
  python3 - "$target" <<'PY'
from pathlib import Path
import sys

target = Path(sys.argv[1])
lines = [
    "Synthetic Theses similarity report",
    "Podobnost 1 %",
    "vyhodnoceno: 12. 5. 2026 12:07",
]

def escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")

content_lines = ["BT", "/F1 10 Tf", "72 760 Td", "12 TL"]
for line in lines:
    content_lines.append(f"({escape(line)}) Tj")
    content_lines.append("T*")
content_lines.append("ET")
content = ("\n".join(content_lines) + "\n").encode("ascii")

objects = [
    b"<< /Type /Catalog /Pages 2 0 R >>",
    b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
    b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
    b"/Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>",
    b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
    b"<< /Length " + str(len(content)).encode("ascii") + b" >>\nstream\n" + content + b"endstream",
]

body = b"%PDF-1.4\n"
offsets = []
for index, obj in enumerate(objects, start=1):
    offsets.append(len(body))
    body += f"{index} 0 obj\n".encode("ascii") + obj + b"\nendobj\n"
xref_offset = len(body)
xref = b"xref\n0 6\n0000000000 65535 f \n"
for offset in offsets:
    xref += f"{offset:010d} 00000 n \n".encode("ascii")
trailer = (
    b"trailer\n<< /Root 1 0 R /Size 6 >>\nstartxref\n"
    + str(xref_offset).encode("ascii")
    + b"\n%%EOF\n"
)
target.write_bytes(body + xref + trailer)
PY
}

round_dir="$repo_root/cases/$case_id/rounds/$round_id"
mkdir -p "$round_dir"/{notes,inputs,extracted,work,outputs}
printf '%s\n' "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
make_pdf "$tmp_dir/theses-Šuľa.pdf"

expect_success "import report through current round" \
  "$repo_root/scripts/import-theses-report" "$case_id" "$tmp_dir/theses-Šuľa.pdf"
expect_output "Intake written:"

test -f "$round_dir/inputs/theses_similarity/report.pdf"
test -f "$round_dir/extracted/theses_similarity/report.txt"
test -f "$round_dir/work/theses_similarity/intake.json"

python3 - "$round_dir" <<'PY'
from pathlib import Path
import hashlib
import json
import sys

round_dir = Path(sys.argv[1])
intake = json.loads((round_dir / "work/theses_similarity/intake.json").read_text(encoding="utf-8"))
pdf = round_dir / "inputs/theses_similarity/report.pdf"
text = round_dir / "extracted/theses_similarity/report.txt"
assert intake["schema_version"] == "theses-similarity-intake-v1"
assert intake["current_submission_link"] == "unverified"
assert intake["report_pdf"]["path"] == "inputs/theses_similarity/report.pdf"
assert intake["report_pdf"]["sha256"] == hashlib.sha256(pdf.read_bytes()).hexdigest()
assert intake["report_pdf"]["page_count"] == 1
assert intake["extracted_text"]["path"] == "extracted/theses_similarity/report.txt"
assert intake["extracted_text"]["sha256"] == hashlib.sha256(text.read_bytes()).hexdigest()
assert intake["overall_similarity"]["numeric_value"] == 1.0
PY

expect_failure "refuse duplicate import" \
  "$repo_root/scripts/import-theses-report" "$case_id" "$tmp_dir/theses-Šuľa.pdf"
expect_output "already imported"

echo "Theses.cz similarity report import smoke passed"
