#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_id="__opponent_packets_smoke_$$"
round_id="round-a"
round_dir="$repo_root/cases/$case_id/rounds/$round_id"
out_file="/tmp/opponent-packets-smoke.$$.out"
err_file="/tmp/opponent-packets-smoke.$$.err"

cleanup() {
  rm -f "$out_file" "$err_file"
  rm -rf "$repo_root/cases/$case_id"
}
trap cleanup EXIT

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_output() {
  local needle="$1"
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

mkdir -p "$round_dir/notes" "$round_dir/inputs" "$round_dir/extracted" "$round_dir/work"
mkdir -p "$round_dir/inputs/submitted-src"
cat >"$repo_root/cases/$case_id/case.md" <<'EOF'
Work type: BP
Academic year: 2025/2026
Student feedback language: cs
Reviewer profile: default
EOF
echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
cat >"$round_dir/notes/assignment.md" <<'EOF'
# Assignment Context

## Formal Assignment Artifacts

- Synthetic assignment artifact is available.

## Formal Assignment Text Or Summary

- Implement and evaluate a synthetic thesis-review helper.

## Private Assignment Notes For Student

- Synthetic private note.
EOF
printf 'Synthetic extracted thesis text.\n' >"$round_dir/extracted/thesis.txt"
printf 'Prepared code root: inputs/submitted-src\n' >"$round_dir/work/code_workspace.md"
cat >"$round_dir/notes/opponent-report-operator-feedback.md" <<'EOF'
# Opponent Report Operator Feedback

Synthetic calibration source note.
EOF
python3 - "$round_dir/work/assignment_coverage_agent.json" "$case_id" "$round_id" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
case_id = sys.argv[2]
round_id = sys.argv[3]
payload = {
    "schema_version": "assignment-coverage-agent-v1",
    "case_id": case_id,
    "round_id": round_id,
    "generated_at": "2026-05-07T00:00:00Z",
    "producer_type": "agent",
    "producer_role": "assignment-coverage-reviewer",
    "producer_agent": "smoke-agent",
    "authorization_note": "Smoke test uses a synthetic agent-authored fixture.",
    "source_refs": ["notes/assignment.md"],
    "assignment_points": [
        {
            "point_id": "A1",
            "summary": "Implement and evaluate a synthetic thesis-review helper.",
            "source_refs": ["notes/assignment.md"],
            "coverage": {
                "status": "covered",
                "evidence_refs": ["notes/assignment.md"],
                "limitations": [],
                "requires_reviewer_verification": False,
            },
        }
    ],
    "limitations": [],
}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
printf '{"classification": "static_setup_present"}\n' >"$round_dir/work/code_reproducibility.json"

expect_success "prepare opponent packets" "$repo_root/scripts/prepare-opponent-packets" "$case_id"
expect_output "Opponent packets: 4"

packet_dir="$round_dir/work/opponent_packets"
common_briefing="$round_dir/work/common_briefing.json"
test -f "$packet_dir/text_structure_assignment.md"
test -f "$packet_dir/code_consistency.md"
test -f "$packet_dir/code_quality.md"
test -f "$packet_dir/current_evidence_snapshot.md"
test -f "$common_briefing"
test ! -f "$packet_dir/figure_media.md"
test ! -f "$packet_dir/literature_citation.md"
test ! -f "$packet_dir/typography_formal.md"

grep -Fq "Schema version: \`opponent-review-packet-v1\`" "$packet_dir/text_structure_assignment.md"
grep -Fq "Common briefing: \`work/common_briefing.json\`" "$packet_dir/text_structure_assignment.md"
grep -Fq '"path": "case.md"' "$common_briefing"
grep -Fq '"path": "profiles/default.md"' "$common_briefing"
grep -Fq '"path": "work/assignment_coverage_agent.json"' "$common_briefing"
grep -Fq '"path": "work/report_calibration_basis.json"' "$common_briefing"
grep -Fq '"report_calibration_sources"' "$common_briefing"
grep -Fq '"path": "notes/opponent-report-operator-feedback.md"' "$common_briefing"
grep -Fq "inputs/submitted-src/" "$common_briefing"
grep -Fq "## Report Calibration Basis" "$packet_dir/text_structure_assignment.md"
grep -Fq "Start from \`work/report_calibration_basis.json\` when present" "$packet_dir/text_structure_assignment.md"
grep -Fq 'Do not run submitted code unless the operator explicitly authorized that run.' "$packet_dir/code_consistency.md"
grep -Fq "Recommended model: \`gpt-5.5\`" "$packet_dir/code_consistency.md"
grep -Fq "## Omen Advisory Static Analysis" "$packet_dir/code_quality.md"
grep -Fq "work/current_evidence_snapshot.json" "$packet_dir/current_evidence_snapshot.md"

echo "Opponent packets smoke passed"
