#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_prefix="__review_manifest_smoke_$$"
created_cases=()

cleanup() {
  local case_id
  for case_id in "${created_cases[@]}"; do
    rm -rf "$repo_root/cases/$case_id"
  done
}
trap cleanup EXIT

make_case() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  created_cases+=("$case_id")
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/outputs"
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/work"
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/notes"
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/inputs"
  {
    echo "Work type: BP"
    echo "Academic year: 2025/2026"
  } >"$repo_root/cases/$case_id/case.md"
  echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
  echo "Synthetic assignment note." >"$repo_root/cases/$case_id/rounds/$round_id/notes/assignment.md"
}

write_output() {
  local case_id="$1"
  local round_id="$2"
  local name="$3"
  local text="${4:-Synthetic output for review manifest smoke.}"
  printf '%s\n' "$text" >"$repo_root/cases/$case_id/rounds/$round_id/outputs/$name"
}

write_valid_code_quality_review() {
  local case_id="$1"
  local round_id="$2"
  cat >"$repo_root/cases/$case_id/rounds/$round_id/outputs/code_quality_review.md" <<'EOF'
# Internal Code Quality Review

## Rozsah kontroly

Reviewed `work/code/project/src/app.py`, `work/code/project/tests/test_app.py`, and `work/code/project/README.md`.

## Technicky prehled implementace

The submitted code is a small Python prototype.

## Hlavni technicka rizika

| Priorita | Oblast | Evidence v kodu | Dopad | Doporuceni |
|---|---|---|---|---|
| P1 | validation | `work/code/project/src/app.py` | invalid input can fail late | add boundary tests |

## Testy, smoke testy a reprodukovatelnost

The README mentions `pytest`, but no submitted code was executed by this validator.

## README, build a vyvojarska dokumentace

`work/code/project/README.md` contains basic setup steps.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Rucni kontroly

- Confirm whether the missing validation affects the final evaluation scenario.
EOF
}

write_valid_code_consistency_review() {
  local case_id="$1"
  local round_id="$2"
  cat >"$repo_root/cases/$case_id/rounds/$round_id/outputs/code_consistency.md" <<'EOF'
# Soulad textu s kodem

## Rozsah kontroly

Checked `extracted/thesis.txt`, `work/code/project/README.md`, and `work/code/project/src/app.py`.

## Podporena tvrzeni

- The README describes the import workflow in `work/code/project/README.md`.

## Nejasna nebo neoverena tvrzeni

| Tvrzeni v textu | Opora v textu | Opora v kodu | Problem |
|---|---|---|---|
| Evaluation accuracy | chapter 4 | `work/code/project/results.csv` | missing calculation path |

## Reprodukovatelnost

Static review only; no submitted code was executed.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Rucni kontroly

- Verify page 42 in the rendered PDF if the exact metric is needed.
EOF
}

write_valid_revision_diff() {
  local case_id="$1"
  local round_id="$2"
  cat >"$repo_root/cases/$case_id/rounds/$round_id/outputs/revision_diff.md" <<'EOF'
# Revision Diff

## Compared Rounds

Compared previous `outputs/feedback_student.md` with current `extracted/thesis.txt`.

## High-Level Progress

The current version adds chapter 4 and README updates.

## Previous Feedback Status

| Prior feedback | Status | Evidence | Follow-up |
|---|---|---|---|
| Add reproducibility notes | partially addressed | `work/code/project/README.md` | verify data path |

## Thesis Text Changes

Chapter 4 now describes evaluation limits.

## Code / Artifact Changes

`inputs/code.zip` changed and now includes `requirements.txt`.

## New Risks

The new metric claim on page 42 still needs calculation evidence.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Items Requiring Manual Check

- Confirm the exact metric source in the rendered PDF.
EOF
}

mark_reviewed() {
  local manifest="$1"
  python3 - "$manifest" <<'PY'
import json
import pathlib
import sys
import hashlib

path = pathlib.Path(sys.argv[1])
manifest = json.loads(path.read_text(encoding="utf-8"))
round_dir = path.parent.parent

def sha256_file(file_path):
    digest = hashlib.sha256()
    with file_path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def final_review_paths(artifact):
    rel_path = artifact["path"]
    artifact_type = artifact["artifact_type"]
    if rel_path == "outputs/feedback_student.md":
        return "supervisor_feedback", "work/feedback_student_draft.md", "work/reviews/feedback_student_review.json"
    if rel_path == "outputs/oponent_podklady_revidovane.md":
        return "opponent_review", "work/oponent_podklady_draft.md", "work/reviews/opponent_materials_review.json"
    if rel_path == "outputs/feedback_k_posudku.md":
        return "opponent_report_review", "work/oponent_posudek_draft.md", "work/reviews/opponent_report_review.json"
    safe_name = artifact_type.replace("/", "_").replace(" ", "_")
    return artifact_type, f"work/reviews/{safe_name}_basis.md", f"work/reviews/{safe_name}_review.json"

def required_observed_checks(rel_path):
    if rel_path == "outputs/feedback_student.md":
        return ["check-supervisor-ready", "check-feedback-language", "check-feedback-output"]
    if rel_path == "outputs/oponent_podklady_revidovane.md":
        return ["check-round-ready", "check-opponent-materials", "check-opponent-report"]
    if rel_path == "outputs/feedback_k_posudku.md":
        return ["check-opponent-report"]
    if rel_path == "outputs/vedouci_posudek_revidovany.md":
        return ["check-supervisor-report-ready", "check-supervisor-report"]
    return ["smoke-review"]

for check in manifest["helper_checks"]:
    check["status"] = "passed"
    check["checked_at"] = "2026-05-04T00:00:00Z"
    check["exit_code"] = 0
for artifact in manifest["artifacts"]:
    skills = artifact.get("skills") or [artifact["artifact_type"]]
    generator_role = skills[0]
    reviewer_role = skills[-1] if len(skills) > 1 else f"{skills[0]}-review"
    review_basis_path = ""
    review_basis_sha256 = ""
    approval_record_path = ""
    if artifact.get("review_scope") in {"sendable_final", "standalone_final"}:
        workflow_profile, review_basis_path, approval_record_path = final_review_paths(artifact)
        basis = round_dir / review_basis_path
        basis.parent.mkdir(parents=True, exist_ok=True)
        if not basis.is_file():
            basis.write_text(f'# Smoke review basis for {artifact["path"]}\n', encoding="utf-8")
        approval = round_dir / approval_record_path
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval_payload = {
            "case_id": manifest["case_id"],
            "round_id": manifest["round_id"],
            "workflow_profile": workflow_profile,
            "reviewer_role": reviewer_role,
            "reviewer_agent": "reviewer-agent",
            "verdict": "approved",
            "blocking_findings_count": 0,
            "reviewed_artifact_path": artifact["path"],
            "reviewed_artifact_sha256": artifact["artifact_sha256"],
            "review_basis_path": review_basis_path,
            "review_basis_sha256": sha256_file(basis),
            "checks_observed": required_observed_checks(artifact["path"]),
            "limitations": ["None."],
            "timestamp": "2026-05-04T00:01:00Z",
        }
        approval.write_text(json.dumps(approval_payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        review_basis_sha256 = approval_payload["review_basis_sha256"]
    artifact["generated_by"] = [
        {
            "role": generator_role,
            "agent": "generator-agent",
            "contribution": "generation",
            "notes": "Smoke generator.",
        }
    ]
    artifact["independent_review"] = {
        "status": "reviewed",
        "reviewer_role": reviewer_role,
        "reviewer_agent": "reviewer-agent",
        "reviewed_at": "2026-05-04T00:01:00Z",
        "reviewed_hash": artifact["artifact_sha256"],
        "covered_by_artifact": "",
        "used_findings": "",
        "exception": "",
        "notes": "Smoke review passed.",
        "review_basis_path": review_basis_path,
        "review_basis_sha256": review_basis_sha256,
        "approval_record_path": approval_record_path,
    }
    artifact["limitations"] = ["None."]
path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
  local round_dir
  local case_dir
  local case_id
  local round_id
  round_dir="$(dirname "$(dirname "$manifest")")"
  round_id="$(basename "$round_dir")"
  case_dir="$(dirname "$(dirname "$round_dir")")"
  case_id="$(basename "$case_dir")"
  "$repo_root/scripts/init-review-manifest" "$case_id" "$round_id" >/dev/null
  python3 - "$manifest" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
manifest = json.loads(path.read_text(encoding="utf-8"))
for check in manifest.get("helper_checks", []):
    if check.get("check") == "check-review-manifest":
        check["status"] = "not_applicable"
        check["checked_at"] = ""
        check["exit_code"] = None
    else:
        check["status"] = "passed"
        check["checked_at"] = "2026-05-04T00:02:00Z"
        check["exit_code"] = 0
path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

mark_artifacts_reviewed_only() {
  local manifest="$1"
  python3 - "$manifest" <<'PY'
import json
import pathlib
import sys
import hashlib

path = pathlib.Path(sys.argv[1])
manifest = json.loads(path.read_text(encoding="utf-8"))
round_dir = path.parent.parent

def sha256_file(file_path):
    digest = hashlib.sha256()
    with file_path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def final_review_paths(artifact):
    rel_path = artifact["path"]
    artifact_type = artifact["artifact_type"]
    if rel_path == "outputs/feedback_student.md":
        return "supervisor_feedback", "work/feedback_student_draft.md", "work/reviews/feedback_student_review.json"
    if rel_path == "outputs/oponent_podklady_revidovane.md":
        return "opponent_review", "work/oponent_podklady_draft.md", "work/reviews/opponent_materials_review.json"
    if rel_path == "outputs/feedback_k_posudku.md":
        return "opponent_report_review", "work/oponent_posudek_draft.md", "work/reviews/opponent_report_review.json"
    safe_name = artifact_type.replace("/", "_").replace(" ", "_")
    return artifact_type, f"work/reviews/{safe_name}_basis.md", f"work/reviews/{safe_name}_review.json"

def required_observed_checks(rel_path):
    if rel_path == "outputs/feedback_student.md":
        return ["check-supervisor-ready", "check-feedback-language", "check-feedback-output"]
    if rel_path == "outputs/oponent_podklady_revidovane.md":
        return ["check-round-ready", "check-opponent-materials", "check-opponent-report"]
    if rel_path == "outputs/feedback_k_posudku.md":
        return ["check-opponent-report"]
    if rel_path == "outputs/vedouci_posudek_revidovany.md":
        return ["check-supervisor-report-ready", "check-supervisor-report"]
    return ["smoke-review"]

def upsert_supporting_record(rel_path):
    records = manifest.setdefault("supporting_work_artifacts", [])
    artifact_hash = sha256_file(round_dir / rel_path)
    for record in records:
        if isinstance(record, dict) and record.get("path") == rel_path:
            record["kind"] = "structured_data"
            record["artifact_sha256"] = artifact_hash
            return
    records.append({"path": rel_path, "kind": "structured_data", "artifact_sha256": artifact_hash})

for artifact in manifest["artifacts"]:
    skills = artifact.get("skills") or [artifact["artifact_type"]]
    generator_role = skills[0]
    reviewer_role = skills[-1] if len(skills) > 1 else f"{skills[0]}-review"
    review_basis_path = ""
    review_basis_sha256 = ""
    approval_record_path = ""
    if artifact.get("review_scope") in {"sendable_final", "standalone_final"}:
        workflow_profile, review_basis_path, approval_record_path = final_review_paths(artifact)
        basis = round_dir / review_basis_path
        basis.parent.mkdir(parents=True, exist_ok=True)
        if not basis.is_file():
            basis.write_text(f'# Smoke review basis for {artifact["path"]}\n', encoding="utf-8")
        approval = round_dir / approval_record_path
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval_payload = {
            "case_id": manifest["case_id"],
            "round_id": manifest["round_id"],
            "workflow_profile": workflow_profile,
            "reviewer_role": reviewer_role,
            "reviewer_agent": "reviewer-agent",
            "verdict": "approved",
            "blocking_findings_count": 0,
            "reviewed_artifact_path": artifact["path"],
            "reviewed_artifact_sha256": artifact["artifact_sha256"],
            "review_basis_path": review_basis_path,
            "review_basis_sha256": sha256_file(basis),
            "checks_observed": required_observed_checks(artifact["path"]),
            "limitations": ["None."],
            "timestamp": "2026-05-04T00:01:00Z",
        }
        approval.write_text(json.dumps(approval_payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        review_basis_sha256 = approval_payload["review_basis_sha256"]
        upsert_supporting_record(approval_record_path)
    artifact["generated_by"] = [
        {
            "role": generator_role,
            "agent": "generator-agent",
            "contribution": "generation",
            "notes": "Smoke generator.",
        }
    ]
    artifact["independent_review"] = {
        "status": "reviewed",
        "reviewer_role": reviewer_role,
        "reviewer_agent": "reviewer-agent",
        "reviewed_at": "2026-05-04T00:01:00Z",
        "reviewed_hash": artifact["artifact_sha256"],
        "covered_by_artifact": "",
        "used_findings": "",
        "exception": "",
        "notes": "Smoke review passed.",
        "review_basis_path": review_basis_path,
        "review_basis_sha256": review_basis_sha256,
        "approval_record_path": approval_record_path,
    }
    artifact["limitations"] = ["None."]
path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

mutate_manifest() {
  local manifest="$1"
  local code="$2"
  python3 - "$manifest" "$code" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
code = sys.argv[2]
manifest = json.loads(path.read_text(encoding="utf-8"))
exec(code, {"manifest": manifest})
path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

add_calibration_output_sources() {
  local manifest="$1"
  python3 - "$manifest" <<'PY'
import hashlib
import json
import pathlib
import sys

manifest_path = pathlib.Path(sys.argv[1])
round_dir = manifest_path.parents[1]
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
note = round_dir / "notes/assignment.md"
sources = round_dir / "work/opponent_packets/current_case_sources.md"
calibration = round_dir / "work/opponent_packets/calibration_context.md"
sources.parent.mkdir(parents=True, exist_ok=True)
sources.write_text("# Current case sources\n", encoding="utf-8")
calibration.write_text("# Calibration context\n", encoding="utf-8")

def sha(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

for artifact in manifest["artifacts"]:
    if artifact["path"] == "outputs/reference_report_comparison.md":
        refs = ["notes/assignment.md", "work/opponent_packets/current_case_sources.md", "work/opponent_packets/calibration_context.md"]
        artifact["input_refs"] = ["notes/assignment.md"]
        artifact["evidence_refs"] = ["work/opponent_packets/current_case_sources.md", "work/opponent_packets/calibration_context.md"]
        artifact["source_sha256"] = {ref: sha(round_dir / ref) for ref in refs}
    elif artifact["path"] == "outputs/opponent_reading_packet.md":
        refs = [
            "notes/assignment.md",
            "work/opponent_packets/current_case_sources.md",
            "work/opponent_packets/calibration_context.md",
            "outputs/reference_report_comparison.md",
        ]
        artifact["input_refs"] = ["notes/assignment.md"]
        artifact["evidence_refs"] = [
            "work/opponent_packets/current_case_sources.md",
            "work/opponent_packets/calibration_context.md",
            "outputs/reference_report_comparison.md",
        ]
        artifact["source_sha256"] = {ref: sha(round_dir / ref) for ref in refs}
manifest["supporting_work_artifacts"] = [
    {"path": "work/opponent_packets/current_case_sources.md", "kind": "text", "artifact_sha256": sha(sources)},
    {"path": "work/opponent_packets/calibration_context.md", "kind": "text", "artifact_sha256": sha(calibration)},
]
manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

expect_success() {
  local name="$1"
  shift
  if ! "$@" >/tmp/check-review-manifest.out 2>/tmp/check-review-manifest.err; then
    echo "Expected success but failed: $name" >&2
    cat /tmp/check-review-manifest.err >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift
  if "$@" >/tmp/check-review-manifest.out 2>/tmp/check-review-manifest.err; then
    echo "Expected failure but passed: $name" >&2
    cat /tmp/check-review-manifest.out >&2
    exit 1
  fi
}

case_id="${case_prefix}_missing"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
expect_failure "missing manifest" "$repo_root/scripts/check-review-manifest" "$case_id" round-a

case_id="${case_prefix}_dot_round"
make_case "$case_id"
echo "..." >"$repo_root/cases/$case_id/current-round.txt"
expect_failure "dot-only current round fails init" "$repo_root/scripts/init-review-manifest" "$case_id"
expect_failure "dot-only current round fails check" "$repo_root/scripts/check-review-manifest" "$case_id"

case_id="${case_prefix}_valid"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_reviewed "$manifest"
expect_success "valid reviewed final artifact" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_unreviewed_final"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
expect_failure "initialized final artifact without review fails closeout" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_unrecorded_checks"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_artifacts_reviewed_only "$manifest"
expect_failure "required helper checks must be recorded as passed" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_internal"
make_case "$case_id"
write_valid_code_quality_review "$case_id" round-a
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
expect_failure "internal evidence requires its validator check" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_calibration_outputs"
make_case "$case_id"
write_output "$case_id" round-a reference_report_comparison.md "# Reference Report Comparison"
write_output "$case_id" round-a opponent_reading_packet.md "# Opponent Reading Packet"
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
expect_failure "calibration outputs require independent review" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a
mark_reviewed "$manifest"
add_calibration_output_sources "$manifest"
expect_success "calibration outputs pass after independent review" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a
write_output "$case_id" round-a reference_report_comparison.md "# Edited Reference Report Comparison"
expect_failure "calibration output edit makes review stale" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_run_checks"
make_case "$case_id"
write_valid_code_quality_review "$case_id" round-a
write_valid_code_consistency_review "$case_id" round-a
write_valid_revision_diff "$case_id" round-a
"$repo_root/scripts/init-review-manifest" --run-checks "$case_id" round-a >/dev/null
expect_success "run-checks records self validation" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_source_code"
make_case "$case_id"
mkdir -p "$repo_root/cases/$case_id/rounds/round-a/inputs/code"
printf 'print("smoke")\n' >"$repo_root/cases/$case_id/rounds/round-a/inputs/code/main.py"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_reviewed "$manifest"
expect_failure "source code input requires code evidence for final feedback" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_covered_findings"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
write_valid_code_quality_review "$case_id" round-a
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_reviewed "$manifest"
mutate_manifest "$manifest" 'manifest["artifacts"][0]["review_scope"] = "covered_by_synthesis"; manifest["artifacts"][0]["independent_review"] = {"status": "not_required", "reviewer_role": "", "reviewer_agent": "", "reviewed_at": "", "reviewed_hash": "", "covered_by_artifact": "outputs/feedback_student.md", "used_findings": "not_recorded", "evidence_hash": manifest["artifacts"][0]["artifact_sha256"], "exception": "Covered by synthesis.", "notes": ""}'
expect_failure "covered_by_synthesis needs used findings" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_missing_record"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
write_output "$case_id" round-a revision_diff.md "Later output not in manifest."
expect_failure "outputs file missing under require-complete" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_digest"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_reviewed "$manifest"
write_output "$case_id" round-a feedback_student.md "Edited after review."
expect_failure "digest mismatch after edit" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_pending"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mutate_manifest "$manifest" 'manifest["artifacts"][0]["independent_review"]["status"] = "not_reviewed"; manifest["artifacts"][0]["independent_review"]["exception"] = ""; manifest["artifacts"][0]["limitations"] = []'
expect_failure "final artifact pending review without exception" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_same_agent"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_reviewed "$manifest"
mutate_manifest "$manifest" 'manifest["artifacts"][0]["independent_review"]["reviewer_agent"] = "generator-agent"'
expect_failure "same generator and reviewer" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_absolute"
make_case "$case_id"
write_output "$case_id" round-a feedback_student.md
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
manifest="$repo_root/cases/$case_id/rounds/round-a/work/review_manifest.json"
mark_reviewed "$manifest"
mutate_manifest "$manifest" 'manifest["inputs"].append({"path": "/home/example/private.pdf", "kind": "pdf"})'
expect_failure "absolute path in evidence" "$repo_root/scripts/check-review-manifest" --require-complete "$case_id" round-a

case_id="${case_prefix}_code_workspace_supporting"
make_case "$case_id"
write_valid_code_quality_review "$case_id" round-a
round_dir="$repo_root/cases/$case_id/rounds/round-a"
mkdir -p "$round_dir/work/code"
printf '%s\n' '# Code Workspace Preparation' >"$round_dir/work/code_workspace.md"
printf '%s\n' '{"schema":"serena-code-roots-v1","roots":[]}' >"$round_dir/work/serena_roots.json"
printf '%s\n' '{"schema":"prepare-code-workspace-manifest-v1","sources":{}}' >"$round_dir/work/code/.prepare-code-workspace-manifest.json"
"$repo_root/scripts/init-review-manifest" "$case_id" round-a >/dev/null
python3 - "$round_dir/work/review_manifest.json" <<'PY'
import json
import pathlib
import sys

manifest = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
paths = {item["path"] for item in manifest["supporting_work_artifacts"]}
expected = {
    "work/code_workspace.md",
    "work/serena_roots.json",
    "work/code/.prepare-code-workspace-manifest.json",
}
missing = expected - paths
assert not missing, missing
PY

echo "Review manifest smoke passed"
