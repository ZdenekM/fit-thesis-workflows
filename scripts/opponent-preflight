#!/usr/bin/env python3
"""Prepare and check a thesis round before opponent-materials generation."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

from thesis_code_workspace import (
    direct_input_code_dirs,
    is_archive,
    is_unsupported_archive,
    probe_archive,
)


ID_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


@dataclass(frozen=True)
class Step:
    label: str
    command: list[str] | None
    returncode: int
    output: str
    required: bool

    @property
    def ok(self) -> bool:
        return self.returncode == 0

    @property
    def status(self) -> str:
        if self.ok:
            return "PASS"
        return "FAIL" if self.required else "WARN"


def repo_root() -> Path:
    output = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True)
    return Path(output.strip())


def validate_id(label: str, value: str) -> None:
    if not ID_RE.fullmatch(value) or set(value) == {"."}:
        raise SystemExit(
            f"Invalid {label}. Use only letters, numbers, dot, underscore, and dash; dot-only ids are not allowed."
        )


def resolve_round(case_dir: Path, round_id: str | None) -> str:
    if round_id:
        validate_id("ROUND_ID", round_id)
        return round_id
    current = case_dir / "current-round.txt"
    if not current.is_file():
        raise SystemExit(f"Missing current round: {case_dir}/current-round.txt")
    resolved = current.read_text(encoding="utf-8").strip()
    validate_id("ROUND_ID", resolved)
    return resolved


def run(root: Path, label: str, args: list[str], *, required: bool) -> Step:
    completed = subprocess.run(
        [str(root / args[0]), *args[1:]],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    return Step(
        label=label,
        command=args,
        returncode=completed.returncode,
        output=completed.stdout.strip(),
        required=required,
    )


def compact(value: str, *, limit: int = 900) -> str:
    lines = [line.rstrip() for line in value.splitlines() if line.strip()]
    text = "\n".join(lines)
    if len(text) > limit:
        return text[: limit - 3] + "..."
    return text


def print_step(step: Step) -> None:
    print()
    print(f"## {step.label}: {step.status}")
    if step.command is not None:
        print(f"$ {' '.join(step.command)}")
    if step.output:
        print(compact(step.output))


def code_inputs(round_dir: Path) -> tuple[bool, list[str]]:
    inputs = round_dir / "inputs"
    if not inputs.is_dir():
        return False, []
    evidence: list[str] = []
    for directory in direct_input_code_dirs(inputs):
        evidence.append(directory.relative_to(round_dir).as_posix())
    for path in sorted(inputs.iterdir()):
        if path.is_symlink() or path.is_dir():
            continue
        if not (is_archive(path) or is_unsupported_archive(path)):
            continue
        if is_unsupported_archive(path):
            folded = path.name.lower()
            if any(token in folded for token in ("code", "src", "repo", "project", "submission")):
                evidence.append(f"{path.relative_to(round_dir).as_posix()} (unsupported archive)")
            continue
        probe = probe_archive(path)
        if probe.possible_code:
            evidence.append(path.relative_to(round_dir).as_posix())
    return bool(evidence), evidence


def github_notes(round_dir: Path) -> list[str]:
    notes_dir = round_dir / "notes"
    hits: list[str] = []
    if not notes_dir.is_dir():
        return hits
    for path in sorted(notes_dir.glob("*.md")):
        text = path.read_text(encoding="utf-8", errors="ignore")
        if "github.com" in text.lower():
            hits.append(path.relative_to(round_dir).as_posix())
    return hits


def github_intake_available(round_dir: Path) -> bool:
    return (round_dir / "outputs" / "github_code_intake.md").is_file() or (
        round_dir / "work" / "github-intake"
    ).is_dir()


def github_out_of_scope(round_dir: Path) -> bool:
    notes_dir = round_dir / "notes"
    if not notes_dir.is_dir():
        return False
    marker_re = re.compile(r"github(?: repo/pr)? intake(?: is)? out of scope", re.IGNORECASE)
    for path in sorted(notes_dir.glob("*.md")):
        text = path.read_text(encoding="utf-8", errors="ignore")
        if marker_re.search(text):
            return True
    return False


def output_next_actions(
    *,
    round_dir: Path,
    code_present: bool,
    code_evidence: list[str],
    github_hits: list[str],
    prepared_code: bool,
) -> None:
    print()
    print("## Opponent Preflight Summary")
    print("- Purpose: import/readiness/tooling check before authorized opponent-materials agents start.")
    if code_present:
        print(f"- Code evidence detected: yes ({', '.join(code_evidence)})")
        if prepared_code:
            print("- Code workspace preparation ran; inspect `work/code_workspace.md` before delegating code reviewers.")
        elif (round_dir / "work" / "code_workspace.md").is_file():
            print("- Code workspace report already exists: `work/code_workspace.md`.")
        else:
            print("- Code workspace was not prepared; run `scripts/prepare-code-workspace` before code review.")
    else:
        print("- Code evidence detected: no local code archive or code-like input directory.")
    if github_hits and not github_intake_available(round_dir):
        print(
            "- GitHub URL evidence appears in notes but `outputs/github_code_intake.md` is missing; "
            "run `scripts/import-github-code` or record `GitHub intake out of scope: <reason>` in round notes."
        )
        for hit in github_hits:
            print(f"  - {hit}")
    print("- If this preflight has FAIL items, fix them before generating opponent materials.")
    print("- If it passes, start the role-split opponent workflow with explicit agent authorization.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="scripts/opponent-preflight",
        description="Run practical preflight checks before opponent-materials generation.",
    )
    parser.add_argument("case_id")
    parser.add_argument("round_id", nargs="?")
    parser.add_argument(
        "--no-prepare-code",
        action="store_true",
        help="do not run prepare-code-workspace even when local code evidence is present",
    )
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv[1:])
    validate_id("CASE_ID", args.case_id)
    root = repo_root()
    case_dir = root / "cases" / args.case_id
    if not case_dir.is_dir():
        raise SystemExit(f"Case does not exist: cases/{args.case_id}")
    round_id = resolve_round(case_dir, args.round_id)
    round_dir = case_dir / "rounds" / round_id
    if not round_dir.is_dir():
        raise SystemExit(f"Round does not exist: cases/{args.case_id}/rounds/{round_id}")

    print("Opponent Preflight")
    print(f"Case: cases/{args.case_id}")
    print(f"Round: cases/{args.case_id}/rounds/{round_id}")

    steps: list[Step] = []
    steps.append(
        run(root, "Round readiness", ["scripts/check-round-ready", args.case_id, round_id], required=True)
    )
    steps.append(
        run(root, "Tooling preflight", ["scripts/check-tooling", "--fast", args.case_id, round_id], required=True)
    )

    code_present, code_evidence = code_inputs(round_dir)
    github_hits = github_notes(round_dir)
    github_missing_intake = bool(
        github_hits and not github_intake_available(round_dir) and not github_out_of_scope(round_dir)
    )
    prepared_code = False
    if code_present and not args.no_prepare_code:
        step = run(
            root,
            "Code workspace preparation",
            ["scripts/prepare-code-workspace", args.case_id, round_id],
            required=True,
        )
        steps.append(step)
        prepared_code = step.ok
    elif code_present:
        steps.append(
            Step(
                label="Code workspace preparation",
                command=None,
                returncode=1,
                output="skipped by --no-prepare-code",
                required=False,
            )
        )

    if github_missing_intake:
        steps.append(
            Step(
                label="GitHub intake",
                command=None,
                returncode=1,
                output=(
                    "GitHub URL evidence is present in notes, but no GitHub intake output/workspace was found. "
                    "Run `scripts/import-github-code` before opponent review or record "
                    "`GitHub intake out of scope: <reason>` in round notes."
                ),
                required=True,
            )
        )

    steps.append(
        run(root, "Case doctor", ["scripts/case-doctor", args.case_id, round_id], required=True)
    )

    for step in steps:
        print_step(step)

    output_next_actions(
        round_dir=round_dir,
        code_present=code_present,
        code_evidence=code_evidence,
        github_hits=github_hits,
        prepared_code=prepared_code,
    )

    return 1 if any(not step.ok and step.required for step in steps) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
