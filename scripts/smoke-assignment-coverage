#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_id="__assignment_coverage_smoke_$$"
round_id="round-a"
round_dir="$repo_root/cases/$case_id/rounds/$round_id"
out_file="/tmp/assignment-coverage-smoke.$$.out"
err_file="/tmp/assignment-coverage-smoke.$$.err"

cleanup() {
  rm -f "$out_file" "$err_file"
  rm -rf "$repo_root/cases/$case_id"
}
trap cleanup EXIT

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift
  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    exit 1
  fi
}

expect_output() {
  local needle="$1"
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

mkdir -p "$round_dir/notes" "$round_dir/outputs" "$round_dir/work"
cat >"$repo_root/cases/$case_id/case.md" <<'EOF'
Work type: BP
Academic year: 2025/2026
Student feedback language: cs
Reviewer profile: default
EOF
echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
cat >"$round_dir/notes/assignment.md" <<'EOF'
# Assignment Context

## Formal Assignment Artifacts

- Synthetic assignment is available.

## Formal Assignment Text Or Summary

- Implement prototype for import workflow.
- Evaluate usability with students.

## Private Assignment Notes For Student

None.

## Assignment Coverage Hints

- Describe deployment limits.
EOF
expect_failure "missing structured assignment coverage" "$repo_root/scripts/check-assignment-coverage" "$case_id"
expect_output "missing structured evidence artifact"

python3 - "$round_dir/work/assignment_coverage_agent.json" "$case_id" "$round_id" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
case_id = sys.argv[2]
round_id = sys.argv[3]
payload = {
    "schema_version": "assignment-coverage-agent-v1",
    "case_id": case_id,
    "round_id": round_id,
    "generated_at": "2026-05-07T00:00:00Z",
    "producer_type": "agent",
    "producer_role": "assignment-coverage-reviewer",
    "producer_agent": "smoke-agent",
    "authorization_note": "Smoke test uses a synthetic agent-authored fixture.",
    "source_refs": ["notes/assignment.md"],
    "assignment_points": [
        {
            "point_id": "A1",
            "summary": "Implement prototype for import workflow.",
            "source_refs": ["notes/assignment.md"],
            "coverage": {
                "status": "covered",
                "evidence_refs": ["notes/assignment.md"],
                "limitations": [],
                "requires_reviewer_verification": False,
            },
        },
        {
            "point_id": "A2",
            "summary": "Evaluate usability with students.",
            "source_refs": ["notes/assignment.md"],
            "coverage": {
                "status": "not_verifiable",
                "evidence_refs": [],
                "limitations": ["Synthetic smoke does not include thesis evidence."],
                "requires_reviewer_verification": True,
            },
        },
    ],
    "limitations": [],
}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY

expect_success "structured assignment coverage" "$repo_root/scripts/check-assignment-coverage" "$case_id"
expect_output "Assignment coverage structured artifact check passed"
expect_output "Assignment points: 2"
test -f "$round_dir/work/assignment_coverage_agent.json"
test ! -f "$round_dir/work/assignment_coverage_map.json"

echo "Assignment coverage smoke passed"
