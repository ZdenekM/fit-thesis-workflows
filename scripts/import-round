#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/import-round CASE_ID ROUND_LABEL [INPUT_PATH ...]

Creates a new timestamped round and optionally copies thesis/code artifacts into inputs/.
INPUT_PATH can be a file or directory. Paths are copied by basename.

Examples:
  scripts/import-round novak-bp-2026 second-review thesis.pdf student-code.zip
  scripts/import-round novak-bp-2026 final-check ~/Downloads/thesis.pdf ~/Downloads/repo
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 2 ]]; then
  usage >&2
  exit 2
fi

case_id="$1"
round_label="$2"
shift 2

if [[ ! "$case_id" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "Invalid CASE_ID. Use only letters, numbers, dot, underscore, and dash." >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel)"
case_dir="$repo_root/cases/$case_id"

replace_field() {
  local file="$1"
  local field="$2"
  local value="$3"
  local tmp
  tmp="$(mktemp)"
  awk -v field="$field" -v value="$value" '
    index($0, field ":") == 1 { print field ": " value; next }
    { print }
  ' "$file" >"$tmp"
  mv "$tmp" "$file"
}

if [[ ! -d "$case_dir" ]]; then
  echo "Case does not exist: cases/$case_id" >&2
  echo "Create it first with: scripts/new-case $case_id" >&2
  exit 1
fi

declare -A target_basenames=()
for input_path in "$@"; do
  if [[ ! -e "$input_path" ]]; then
    echo "Input path does not exist: $input_path" >&2
    exit 1
  fi
  basename="$(basename "$input_path")"
  if [[ -n "${target_basenames[$basename]:-}" ]]; then
    echo "Multiple inputs would copy to the same basename: $basename" >&2
    exit 1
  fi
  target_basenames[$basename]=1
done

timestamp="$(date +%Y%m%d-%H%M%S)"
safe_label="$(printf '%s' "$round_label" | tr -cs '[:alnum:]_.-' '-' | sed 's/^-//; s/-$//')"
if [[ -z "$safe_label" ]]; then
  echo "ROUND_LABEL must contain at least one letter, number, dot, underscore, or dash." >&2
  exit 2
fi
round_id="$timestamp-$safe_label"
round_dir="$case_dir/rounds/$round_id"
tmp_round_dir="$case_dir/rounds/.tmp-$round_id-$$"

if [[ -e "$round_dir" ]]; then
  echo "Round already exists: cases/$case_id/rounds/$round_id" >&2
  exit 1
fi
if [[ -e "$tmp_round_dir" ]]; then
  echo "Temporary round directory already exists: $tmp_round_dir" >&2
  exit 1
fi

cleanup_tmp_round() {
  rm -rf "$tmp_round_dir"
}
trap cleanup_tmp_round EXIT

mkdir -p "$tmp_round_dir"/{notes,inputs,extracted,work,outputs}

cp "$repo_root/templates/round-notes.md" "$tmp_round_dir/notes/round-notes.md"
cp "$repo_root/templates/assignment.md" "$tmp_round_dir/notes/assignment.md"
cp "$repo_root/templates/supervisor-intake.md" "$tmp_round_dir/notes/supervisor-intake.md"
cp "$repo_root/templates/opponent-intake.md" "$tmp_round_dir/notes/opponent-intake.md"
cp "$repo_root/templates/opponent-report-review-intake.md" "$tmp_round_dir/notes/opponent-report-review-intake.md"

replace_field "$tmp_round_dir/notes/round-notes.md" "Round" "$round_id"
replace_field "$tmp_round_dir/notes/round-notes.md" "Date" "$(date +%F)"

for input_path in "$@"; do
  cp -R "$input_path" "$tmp_round_dir/inputs/"

  if [[ -f "$input_path" && "${input_path,,}" == *.pdf ]]; then
    pdf_basename="$(basename "$input_path")"
    extracted_name="${pdf_basename%.*}.txt"
    if command -v pdftotext >/dev/null 2>&1; then
      if pdftotext -layout "$input_path" "$tmp_round_dir/extracted/$extracted_name"; then
        echo "Extracted PDF text: extracted/$extracted_name"
      else
        rm -f "$tmp_round_dir/extracted/$extracted_name"
        echo "PDF text extraction failed for $pdf_basename; keep the PDF in inputs/ and note the limitation." >&2
      fi
    else
      echo "pdftotext not found; PDF text was not extracted for $pdf_basename" >&2
    fi
  fi
done

previous_index="$tmp_round_dir/notes/previous-feedback-index.md"
{
  echo "# Previous Feedback Index"
  echo
  echo "Use these artifacts when preparing iterative supervisor feedback."
  echo
  find "$case_dir/rounds" -path "$round_dir" -prune -o -path "*/outputs/feedback_student.md" -type f -print |
    sort |
    sed "s#^$repo_root/##" |
    sed 's#^#- #'
} >"$previous_index"

mv "$tmp_round_dir" "$round_dir"
trap - EXIT
printf '%s\n' "$round_id" >"$case_dir/current-round.txt"

echo "Created round: cases/$case_id/rounds/$round_id"
if [[ $# -gt 0 ]]; then
  echo "Copied inputs: $#"
fi
