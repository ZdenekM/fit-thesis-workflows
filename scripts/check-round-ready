#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/check-round-ready CASE_ID [ROUND_ID]

Checks whether a round has the required assignment context before generating
supervisor feedback or opponent materials.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage >&2
  exit 2
fi

case_id="$1"
repo_root="$(git rev-parse --show-toplevel)"
case_dir="$repo_root/cases/$case_id"

if [[ ! -d "$case_dir" ]]; then
  echo "Case does not exist: cases/$case_id" >&2
  exit 1
fi

round_id="${2:-}"
if [[ -z "$round_id" ]]; then
  if [[ ! -f "$case_dir/current-round.txt" ]]; then
    echo "Missing current round: cases/$case_id/current-round.txt" >&2
    exit 1
  fi
  round_id="$(<"$case_dir/current-round.txt")"
fi

round_dir="$case_dir/rounds/$round_id"
if [[ ! -d "$round_dir" ]]; then
  echo "Round does not exist: cases/$case_id/rounds/$round_id" >&2
  exit 1
fi

assignment_notes="$round_dir/notes/assignment.md"
if [[ ! -f "$assignment_notes" ]]; then
  echo "Missing required assignment context: cases/$case_id/rounds/$round_id/notes/assignment.md" >&2
  echo "Create it from templates/assignment.md before generating feedback or opponent materials." >&2
  exit 1
fi

section_has_content() {
  local heading="$1"
  awk -v heading="$heading" '
    $0 == heading { in_section = 1; next }
    /^## / && in_section { exit }
    in_section &&
      $0 !~ /^[[:space:]]*$/ &&
      $0 !~ /^[[:space:]]*-[[:space:]]*$/ &&
      $0 !~ /^[[:space:]]*TODO[: ]/ {
        found = 1
      }
    END { exit(found ? 0 : 1) }
  ' "$assignment_notes"
}

has_matching_file() {
  local directory="$1"
  local suffix="$2"
  find "$directory" -maxdepth 1 -type f \
    \( -iname "*zadani*.$suffix" -o -iname "*zadání*.$suffix" -o -iname "*assignment*.$suffix" \) \
    -print -quit | grep -q .
}

formal_source_ok=0
if section_has_content "## Formal Assignment Artifacts" || has_matching_file "$round_dir/inputs" "pdf"; then
  formal_source_ok=1
fi

formal_readable_ok=0
if section_has_content "## Formal Assignment Text Or Summary" || has_matching_file "$round_dir/extracted" "txt"; then
  formal_readable_ok=1
fi

private_notes_ok=0
if section_has_content "## Private Assignment Notes For Student"; then
  private_notes_ok=1
fi

failed=0
if [[ "$formal_source_ok" -ne 1 ]]; then
  echo "Missing formal assignment artifact in notes/assignment.md or inputs/." >&2
  failed=1
fi
if [[ "$formal_readable_ok" -ne 1 ]]; then
  echo "Missing readable assignment text: add extracted assignment text or fill Formal Assignment Text Or Summary." >&2
  failed=1
fi
if [[ "$private_notes_ok" -ne 1 ]]; then
  echo "Missing private assignment notes for the student in notes/assignment.md." >&2
  failed=1
fi

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi

echo "Round ready: assignment context is present."
