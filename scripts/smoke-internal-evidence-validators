#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_id="__internal_evidence_smoke_$$"
round_id="round-a"
round_dir="$repo_root/cases/$case_id/rounds/$round_id"
out_file="/tmp/internal-evidence-smoke.$$.out"
err_file="/tmp/internal-evidence-smoke.$$.err"

cleanup() {
  rm -f "$out_file" "$err_file"
  rm -rf "$repo_root/cases/$case_id"
}
trap cleanup EXIT

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure_contains() {
  local name="$1"
  local needle="$2"
  shift 2
  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected failure output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

mkdir -p "$round_dir/outputs"
cat >"$repo_root/cases/$case_id/case.md" <<'EOF'
Work type: BP
Academic year: 2025/2026
Student feedback language: cs
Reviewer profile: default
EOF
echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"

cat >"$round_dir/outputs/code_consistency.md" <<'EOF'
# Soulad textu s kodem

## Rozsah kontroly

Checked `extracted/thesis.txt`, `work/code/project/README.md`, and `work/code/project/src/app.py`.

## Podporena tvrzeni

- Import workflow is described in `work/code/project/README.md`.

## Nejasna nebo neoverena tvrzeni

| Tvrzeni v textu | Opora v textu | Opora v kodu | Problem |
|---|---|---|---|
| Evaluation accuracy | chapter 4 | `work/code/project/results.csv` | missing calculation path |

## Reprodukovatelnost

Static review only; no submitted code was executed.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Synthesis Handoff

- Workflow/audience: supervisor_feedback and opponent_materials.
- Use in synthesis: cite `work/code/project/README.md` for the import workflow claim.
- Do not overstate: do not claim runtime behavior was verified.
- P0/P1 anchors: `work/code/project/results.csv` and chapter 4.
- Limitations/manual checks: no submitted code was executed; verify page 42 if needed.
- Calibration: final-submission check; keep this as report-confidence limitation.
- Supervisor action / opponent impact: ask for calculation evidence or carry a cautious report limitation.

## Rucni kontroly

- Verify page 42 in the rendered PDF if the exact metric is needed.
EOF

cat >"$round_dir/outputs/code_quality_review.md" <<'EOF'
# Internal Code Quality Review

## Rozsah kontroly

Reviewed `work/code/project/src/app.py`, `work/code/project/tests/test_app.py`, and `work/code/project/README.md`.

## Technicky prehled implementace

The submitted code is a small Python prototype.

## Hlavni technicka rizika

| Priorita | Oblast | Evidence v kodu | Dopad | Doporuceni |
|---|---|---|---|---|
| P1 | validation | `work/code/project/src/app.py` | invalid input can fail late | add boundary tests |

## Testy, smoke testy a reprodukovatelnost

The README mentions `pytest`, but no submitted code was executed by this validator.

## README, build a vyvojarska dokumentace

`work/code/project/README.md` contains basic setup steps.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Synthesis Handoff

- Workflow/audience: supervisor_feedback and opponent_materials.
- Use in synthesis: cite `work/code/project/src/app.py` as the validation risk.
- Do not overstate: do not claim the application is non-functional from static review alone.
- P0/P1 anchors: `work/code/project/src/app.py` and `work/code/project/README.md`.
- Limitations/manual checks: no submitted code was executed; confirm final evaluation impact.
- Calibration: late-stage implementation review; keep as maintainability risk unless runtime failure is proven.
- Supervisor action / opponent impact: add boundary tests or record a maintainability/report-confidence limitation.

## Rucni kontroly

- Confirm whether the missing validation affects the final evaluation scenario.
EOF

cat >"$round_dir/outputs/revision_diff.md" <<'EOF'
# Revision Diff

## Compared Rounds

Compared previous `outputs/feedback_student.md` with current `extracted/thesis.txt`.

## High-Level Progress

The current version adds chapter 4 and README updates.

## Previous Feedback Status

| Prior feedback | Status | Evidence | Follow-up |
|---|---|---|---|
| Add reproducibility notes | partially addressed | `work/code/project/README.md` | verify data path |

## Thesis Text Changes

Chapter 4 now describes evaluation limits.

## Code / Artifact Changes

`inputs/code.zip` changed and now includes `requirements.txt`.

## New Risks

The new metric claim on page 42 still needs calculation evidence.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Synthesis Handoff

- Workflow/audience: supervisor_feedback.
- Use in synthesis: cite `outputs/feedback_student.md` and `work/code/project/README.md` for progress tracking.
- Do not overstate: do not claim the metric source is fully resolved.
- P0/P1 anchors: page 42 and `inputs/code.zip`.
- Limitations/manual checks: confirm the rendered PDF metric source.
- Calibration: revision feedback follow-up before final supervisor synthesis.
- Supervisor action / opponent impact: ask for the exact metric source before final feedback.

## Items Requiring Manual Check

- Confirm the exact metric source in the rendered PDF.
EOF

mkdir -p "$round_dir/extracted" "$round_dir/work/source" "$round_dir/work/literature"
printf 'Claim [1] and background [2].\n' >"$round_dir/extracted/thesis.txt"
printf '@article{source1}\n@article{source2}\n' >"$round_dir/work/source/refs.bib"
printf 'Full text extract for selected source.\n' >"$round_dir/work/literature/source-1.txt"

cat >"$round_dir/work/literature/source_acquisition.json" <<'EOF'
{
  "schema_version": "literature-source-acquisition-v1",
  "case_id": "__CASE_ID__",
  "round_id": "round-a",
  "generated_at": "2026-05-18T12:00:00Z",
  "producer_type": "agent",
  "producer_role": "thesis_literature_citation_reviewer",
  "producer_agent": "literature-smoke-agent",
  "source_resolution_policy": "legal_public_sources_only",
  "target_selection_policy": {
    "selected_when": [
      "central to a material claim",
      "metadata mismatch or suspicious claim-source alignment"
    ]
  },
  "source_refs": ["extracted/thesis.txt", "work/source/refs.bib"],
  "citations": [
    {
      "citation_id": "ref-1",
      "citation_label": "[1]",
      "title_or_source": "Selected full-text source",
      "selection_status": "selected",
      "selection_reasons": ["central material claim"],
      "thesis_refs": ["extracted/thesis.txt"],
      "acquisition_status": "full_text_read",
      "attempts": [
        {
          "source_type": "open_repository_pdf",
          "locator": "https://example.test/source-1.pdf",
          "status": "full_text_read"
        }
      ],
      "local_source_refs": ["work/literature/source-1.txt"],
      "source_evidence_refs": ["work/literature/source-1.txt"],
      "claim_support_checked": [
        {
          "claim_ref": "extracted/thesis.txt",
          "verdict": "supports"
        }
      ],
      "limitations": []
    },
    {
      "citation_id": "ref-2",
      "citation_label": "[2]",
      "title_or_source": "Background source",
      "selection_status": "not_selected",
      "selection_reasons": ["not material to contested or central claims"],
      "thesis_refs": ["extracted/thesis.txt"],
      "acquisition_status": "not_attempted_not_material",
      "attempts": [],
      "local_source_refs": [],
      "source_evidence_refs": [],
      "claim_support_checked": [],
      "limitations": []
    }
  ],
  "limitations": []
}
EOF
python3 - "$round_dir" "$round_dir/work/literature/source_acquisition.json" "$case_id" <<'PY'
import hashlib
import json
from pathlib import Path
import sys

round_dir = Path(sys.argv[1])
path = Path(sys.argv[2])
case_id = sys.argv[3]
loaded = json.loads(path.read_text(encoding="utf-8").replace("__CASE_ID__", case_id))
loaded["source_sha256"] = {
    ref: hashlib.sha256((round_dir / ref).read_bytes()).hexdigest()
    for ref in loaded["source_refs"]
}
path.write_text(json.dumps(loaded, indent=2) + "\n", encoding="utf-8")
PY

cat >"$round_dir/outputs/literature_citation_review.md" <<'EOF'
# Literature And Citation Review

## Review Scope

Reviewed `extracted/thesis.txt`, `work/source/refs.bib`, and `work/literature/source_acquisition.json`. One citation was selected for targeted source lookup and one background citation was not selected as material.

## Bibliography Source Map

| Citation | Thesis location / claim supported | Source status | Notes |
|---|---|---|---|
| [1] | `extracted/thesis.txt` | full text read via `work/literature/source-1.txt` | Relevant source for material claim. |
| [2] | `extracted/thesis.txt` | triaged, not selected for external lookup | Background only. |

## Relevant And Well Used Sources

- [FAKT] [1] supports the material claim checked against `work/literature/source-1.txt`.

## Underused Or Weakly Connected Sources

| Priority | Citation | Thesis claim or section | Evidence | Recommendation |
|---|---|---|---|---|
| P2 | [2] | background | `extracted/thesis.txt` | No reportable action. |

## Missing Or Inaccessible Sources

| Citation / area | Status | What is needed | Impact |
|---|---|---|---|
| none selected | no selected source was inaccessible | no action | low |

## Candidate Literature Improvements

Opponent mode: no new literature coaching is needed.

## Synthesis Handoff

- Workflow/audience: opponent_materials internal evidence.
- Use in synthesis: cite `work/literature/source_acquisition.json` for targeted source acquisition.
- Do not overstate: do not claim every bibliography item was full-text checked.
- P0/P1 anchors: `work/literature/source-1.txt` and `extracted/thesis.txt`.
- Limitations/manual checks: only selected key/suspicious citations were checked; verify more sources manually if a new contested claim appears.
- Calibration: final internal evidence with targeted source acquisition, not exhaustive literature audit.
- Supervisor action / opponent impact: no major literature action from this smoke fixture.

## Review Status

Reviewed by downstream synthesis for the findings used in opponent materials.

## Manual Checks

- None for this smoke fixture.
EOF

expect_success "code consistency validator" "$repo_root/scripts/check-code-consistency" "$case_id"
expect_success "code consistency synthesis handoff validator" \
  "$repo_root/scripts/check-code-consistency" --require-synthesis-handoff "$case_id"
expect_success "code quality validator" "$repo_root/scripts/check-code-quality-review" "$case_id"
expect_success "code quality synthesis handoff validator" \
  "$repo_root/scripts/check-code-quality-review" --require-synthesis-handoff "$case_id"
expect_success "revision diff validator" "$repo_root/scripts/check-revision-diff" "$case_id"
expect_success "revision diff synthesis handoff validator" \
  "$repo_root/scripts/check-revision-diff" --require-synthesis-handoff "$case_id"
expect_success "literature citation validator" "$repo_root/scripts/check-literature-citation-review" "$case_id"
expect_success "literature citation synthesis handoff validator" \
  "$repo_root/scripts/check-literature-citation-review" --require-synthesis-handoff "$case_id"

cat >"$round_dir/outputs/code_quality_review.md" <<'EOF'
# Internal Code Quality Review

## Rozsah kontroly

Reviewed `work/code/project/src/app.py`.

## Technicky prehled implementace

Small prototype.

## Hlavni technicka rizika

`work/code/project/src/app.py` has a validation risk.

## Testy, smoke testy a reprodukovatelnost

Limitation: no submitted code was executed.

## README, build a vyvojarska dokumentace

`work/code/project/README.md` was inspected.

## Review Status

Reviewed.

## Synthesis Handoff

- Workflow/audience:
- Use in synthesis:
- Do not overstate:
- P0/P1 anchors:
- Limitations/manual checks:
- Calibration:
- Supervisor action / opponent impact:

## Rucni kontroly

None remain.
EOF

expect_failure_contains "required synthesis handoff rejects blank template" "empty synthesis handoff field" \
  "$repo_root/scripts/check-code-quality-review" --require-synthesis-handoff "$case_id"
expect_success "advisory synthesis handoff warns on blank template" \
  "$repo_root/scripts/check-code-quality-review" --warn-synthesis-handoff "$case_id"

printf '\nTODO: placeholder\n' >>"$round_dir/outputs/revision_diff.md"
expect_failure_contains "revision diff rejects placeholder" "placeholder" "$repo_root/scripts/check-revision-diff" "$case_id"

echo "Internal evidence validators smoke passed"
