#!/usr/bin/env python3
"""Read-only tooling and connector preflight for thesis review workflows."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any

_REPO_SRC = Path(__file__).resolve().parents[1] / "src"
if _REPO_SRC.is_dir():
    sys.path.insert(0, str(_REPO_SRC))

from thesis_review_workflow.cases import MissingCurrentRound, repo_root, resolve_round as resolve_round_core
from thesis_review_workflow.ids import validate_id as validate_id_core


VERSION_RE = re.compile(r"(\d+)(?:\.(\d+))?")
OPTIONAL_COMMANDS = (
    ("vale", "style/prose linting"),
    ("languagetool", "grammar checks"),
    ("hunspell", "spell checks"),
    ("aspell", "spell checks"),
    ("pandoc", "document conversion/reference inspection"),
    ("anystyle", "bibliography parsing"),
    ("grobid_client", "literature PDF reference extraction"),
)
CODEX_MCP_LIST: tuple[int, str] | None = None
FAST_MODE = False
MAX_WALK_FILES = 5000
SAFE_SKIP_DIRS = {
    ".git",
    ".hg",
    ".svn",
    ".cache",
    ".mypy_cache",
    ".pytest_cache",
    "__pycache__",
    "node_modules",
    "dist",
    "build",
    "target",
    ".venv",
    "venv",
}
ARCHIVE_SUFFIXES = {
    ".zip",
    ".tar",
    ".tgz",
    ".tbz",
    ".tbz2",
    ".txz",
    ".gz",
    ".bz2",
    ".xz",
    ".7z",
    ".rar",
    ".tar.gz",
    ".tar.bz2",
    ".tar.xz",
}
MEDIA_SUFFIXES = {".png", ".jpg", ".jpeg", ".webp", ".svg", ".mp4", ".mov", ".avi", ".mkv", ".webm", ".ppt", ".pptx", ".odp", ".key"}


@dataclass
class ToolCheck:
    key: str
    label: str
    status: str
    required: bool
    detail: str
    remediation: str = ""


@dataclass
class Context:
    root: Path
    case_id: str | None
    round_id: str | None
    round_dir: Path | None
    pdf_count: int = 0
    extracted_count: int = 0
    missing_pdf_extracts: int = 0
    pdf_extract_needed: bool = False
    github_relevant: bool = False
    code_relevant: bool = False
    code_archive_count: int = 0
    media_relevant: bool = False


def validate_id(label: str, value: str) -> None:
    try:
        validate_id_core(label, value)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc


def resolve_round(case_dir: Path, round_id: str | None) -> str:
    try:
        return resolve_round_core(case_dir, round_id)
    except (MissingCurrentRound, ValueError) as exc:
        raise SystemExit(str(exc)) from exc


def forced_missing() -> set[str]:
    raw = os.environ.get("THESIS_TOOLING_FORCE_MISSING", "")
    return {item.strip() for item in raw.split(",") if item.strip()}


def command_path(name: str) -> str | None:
    if name in forced_missing():
        return None
    return shutil.which(name)


def run(args: list[str], *, timeout: float = 5.0) -> tuple[int, str]:
    if args and args[0] in forced_missing():
        return 127, f"{args[0]} forced missing by THESIS_TOOLING_FORCE_MISSING"
    try:
        completed = subprocess.run(
            args,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        return 127, f"{args[0]} not found"
    except subprocess.TimeoutExpired:
        return 124, f"{' '.join(args)} timed out after {timeout:g}s"
    output = "\n".join(part for part in [completed.stdout.strip(), completed.stderr.strip()] if part)
    return completed.returncode, compact(output)


def codex_mcp_list() -> tuple[int, str] | None:
    global CODEX_MCP_LIST
    if not command_path("codex"):
        return None
    if CODEX_MCP_LIST is None:
        CODEX_MCP_LIST = run(["codex", "mcp", "list"], timeout=3 if FAST_MODE else 8)
    return CODEX_MCP_LIST


def compact(value: str, *, limit: int = 300) -> str:
    text = " | ".join(line.strip() for line in value.splitlines() if line.strip())
    if len(text) > limit:
        return text[: limit - 3] + "..."
    return text


def first_version_line(output: str) -> str:
    return output.split("|", 1)[0].strip() if output.strip() else "(no version output)"


def parse_major(version_output: str) -> int | None:
    match = VERSION_RE.search(version_output)
    if not match:
        return None
    return int(match.group(1))


def small_text_contains(path: Path, needle: str) -> bool:
    if not path.is_file() or path.stat().st_size > 1024 * 1024:
        return False
    try:
        return needle in path.read_text(encoding="utf-8", errors="ignore").lower()
    except OSError:
        return False


def folded(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_text = "".join(char for char in normalized if not unicodedata.combining(char))
    return ascii_text.lower()


def is_thesis_pdf_name(value: str) -> bool:
    tokens = ("thesis", "prace", "bakalar", "diplom")
    if any(token in value for token in tokens):
        return True
    return bool(re.search(r"(^|[_ .-])(bp|dp)([_ .-]|$)", value))


def matching_extract(pdf: Path, extracted: list[Path], *, pdf_count: int, used_extracts: set[Path]) -> Path | None:
    by_stem = {path.stem: path for path in extracted}
    exact = by_stem.get(pdf.stem)
    if exact is not None and exact not in used_extracts:
        return exact

    pdf_name = folded(pdf.stem)
    assignment_tokens = ("zadani", "assignment")
    if any(token in pdf_name for token in assignment_tokens):
        for path in extracted:
            if path in used_extracts:
                continue
            extract_name = folded(path.stem)
            if any(token in extract_name for token in assignment_tokens):
                return path
    elif is_thesis_pdf_name(pdf_name):
        for path in extracted:
            if path in used_extracts:
                continue
            extract_name = folded(path.stem)
            if extract_name in {"thesis", "prace", "bp", "dp"} or "thesis" in extract_name:
                return path

    if pdf_count == 1 and len(extracted) == 1 and extracted[0] not in used_extracts:
        return extracted[0]
    return None


def count_missing_pdf_extracts(pdfs: list[Path], extracted: list[Path]) -> int:
    used: set[Path] = set()
    missing = 0
    for pdf in pdfs:
        extract = matching_extract(pdf, extracted, pdf_count=len(pdfs), used_extracts=used)
        if extract is None:
            missing += 1
        else:
            used.add(extract)
    return missing


def any_files(base: Path, patterns: tuple[str, ...]) -> bool:
    if not base.is_dir():
        return False
    return any(path.is_file() for pattern in patterns for path in base.rglob(pattern))


def bounded_files(base: Path, *, max_files: int = MAX_WALK_FILES) -> tuple[list[Path], bool]:
    if not base.is_dir():
        return [], False
    files: list[Path] = []
    truncated = False
    for dirpath, dirnames, filenames in os.walk(base):
        dirnames[:] = [name for name in dirnames if name not in SAFE_SKIP_DIRS]
        for filename in filenames:
            files.append(Path(dirpath) / filename)
            if len(files) >= max_files:
                truncated = True
                return files, truncated
    return files, truncated


def archive_suffix(path: Path) -> str:
    suffixes = [suffix.lower() for suffix in path.suffixes]
    if len(suffixes) >= 2 and suffixes[-2:] in (
        [".tar", ".gz"],
        [".tar", ".bz2"],
        [".tar", ".xz"],
    ):
        return "".join(suffixes[-2:])
    return suffixes[-1] if suffixes else ""


def likely_code_archive(path: Path) -> bool:
    if archive_suffix(path) not in ARCHIVE_SUFFIXES:
        return False
    name = folded(path.name)
    non_code_tokens = ("thesis", "latex", "overleaf", "zadani", "assignment", "prace", "bakalar", "diplom", "report")
    if any(token in name for token in non_code_tokens):
        return False
    return True


def build_context(root: Path, case_id: str | None, round_id_arg: str | None) -> Context:
    if case_id is None:
        return Context(root=root, case_id=None, round_id=None, round_dir=None)
    validate_id("CASE_ID", case_id)
    case_dir = root / "cases" / case_id
    if not case_dir.is_dir():
        raise SystemExit(f"Case does not exist: cases/{case_id}")
    round_id = resolve_round(case_dir, round_id_arg)
    round_dir = case_dir / "rounds" / round_id
    if not round_dir.is_dir():
        raise SystemExit(f"Round does not exist: cases/{case_id}/rounds/{round_id}")

    input_files, input_truncated = bounded_files(round_dir / "inputs")
    pdfs = sorted(path for path in input_files if path.suffix.lower() == ".pdf")
    extracted = sorted((round_dir / "extracted").glob("*.txt")) if (round_dir / "extracted").is_dir() else []
    missing_pdf_extracts = count_missing_pdf_extracts(pdfs, extracted)
    code_archives = [
        path
        for path in input_files
        if likely_code_archive(path)
    ]
    github_relevant = (
        (round_dir / "inputs" / "github").is_dir()
        or (round_dir / "work" / "github-intake").is_dir()
        or any("github" in folded(path.name) for path in input_files)
        or any(small_text_contains(path, "github.com") for path in (round_dir / "notes").glob("*.md"))
    )
    code_relevant = bool(code_archives) or any(
        (round_dir / rel).exists()
        for rel in ("inputs/code", "inputs/src", "inputs/source", "inputs/submission", "work/code", "work/serena_roots.json")
    )
    media_relevant = any(path.suffix.lower() in MEDIA_SUFFIXES for path in input_files)
    if input_truncated:
        media_relevant = True
    return Context(
        root=root,
        case_id=case_id,
        round_id=round_id,
        round_dir=round_dir,
        pdf_count=len(pdfs),
        extracted_count=len(extracted),
        missing_pdf_extracts=missing_pdf_extracts,
        pdf_extract_needed=missing_pdf_extracts > 0,
        github_relevant=github_relevant,
        code_relevant=code_relevant,
        code_archive_count=len(code_archives),
        media_relevant=media_relevant,
    )


def check_git(root: Path) -> ToolCheck:
    path = command_path("git")
    if not path:
        return ToolCheck("git", "git", "FAIL", True, "git not found", "Install git and rerun from the repository checkout.")
    code, output = run(["git", "--version"])
    if code != 0:
        return ToolCheck("git", "git", "FAIL", True, output or "git --version failed")
    inside = subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return ToolCheck("git", "git", "FAIL", True, "current directory is not inside a git worktree")
    return ToolCheck("git", "git", "PASS", True, first_version_line(output))


def check_python() -> ToolCheck:
    version = ".".join(str(part) for part in sys.version_info[:3])
    return ToolCheck("python", "Python", "PASS", True, f"python {version}")


def check_pdftotext(ctx: Context) -> ToolCheck:
    path = command_path("pdftotext")
    required = ctx.pdf_extract_needed
    if not path:
        status = "FAIL" if required else "WARN"
        detail = "pdftotext not found"
        if ctx.round_dir:
            detail += f"; PDFs: {ctx.pdf_count}, extracted text files: {ctx.extracted_count}, missing matched extracts: {ctx.missing_pdf_extracts}"
        return ToolCheck("pdftotext", "pdftotext", status, required, detail, "Install poppler-utils or provide extracted text in the round workspace.")
    code, output = run(["pdftotext", "-v"])
    status = "PASS" if code == 0 else ("FAIL" if required else "WARN")
    detail = first_version_line(output) if output else f"pdftotext at {path}"
    if ctx.round_dir:
        detail += f"; PDFs: {ctx.pdf_count}, extracted text files: {ctx.extracted_count}, missing matched extracts: {ctx.missing_pdf_extracts}"
    return ToolCheck("pdftotext", "pdftotext", status, required, detail)


def check_gh(ctx: Context) -> ToolCheck:
    path = command_path("gh")
    if not path:
        status = "WARN" if ctx.github_relevant else "INFO"
        return ToolCheck("gh", "GitHub CLI", status, False, "gh not found", "Install GitHub CLI and authenticate with gh auth login for GitHub intake.")
    code, version = run(["gh", "--version"])
    auth_code, auth = run(["gh", "auth", "status"], timeout=3 if FAST_MODE else 8)
    if auth_code == 0:
        return ToolCheck("gh", "GitHub CLI", "PASS", False, f"{first_version_line(version)}; authenticated")
    status = "WARN" if ctx.github_relevant else "INFO"
    return ToolCheck("gh", "GitHub CLI", status, False, f"{first_version_line(version)}; auth not confirmed: {auth}", "Run gh auth login before GitHub intake.")


def check_node_pdf_reader(ctx: Context) -> list[ToolCheck]:
    checks: list[ToolCheck] = []
    node = command_path("node")
    pdf_detail_relevant = ctx.pdf_count > 0 or ctx.media_relevant
    if not node:
        checks.append(
            ToolCheck(
                "node",
                "Node.js for pdf-reader MCP",
                "WARN" if pdf_detail_relevant else "INFO",
                False,
                "node not found",
                "Install Node.js 22+ only if targeted pdf-reader-mcp detail checks are needed.",
            )
        )
    else:
        code, output = run(["node", "--version"])
        major = parse_major(output)
        if code == 0 and major is not None and major >= 22:
            checks.append(ToolCheck("node", "Node.js for pdf-reader MCP", "PASS", False, first_version_line(output)))
        else:
            checks.append(
                ToolCheck(
                    "node",
                    "Node.js for pdf-reader MCP",
                    "WARN" if pdf_detail_relevant else "INFO",
                    False,
                    first_version_line(output) if output else "node version unavailable",
                    "pdf-reader-mcp expects Node.js 22 or newer.",
                )
            )

    mcp_list = codex_mcp_list()
    if mcp_list is None:
        checks.append(
            ToolCheck(
                "pdf_reader_mcp",
                "pdf-reader MCP",
                "WARN" if pdf_detail_relevant else "INFO",
                False,
                "codex command not found; cannot inspect MCP registration",
            )
        )
        return checks
    code, output = mcp_list
    if code == 0 and "pdf-reader" in output:
        checks.append(ToolCheck("pdf_reader_mcp", "pdf-reader MCP", "PASS", False, "pdf-reader appears in codex mcp list"))
    else:
        status = "WARN" if pdf_detail_relevant else "INFO"
        detail = "pdf-reader not listed by codex mcp list" if code == 0 else f"codex mcp list failed: {output}"
        checks.append(ToolCheck("pdf_reader_mcp", "pdf-reader MCP", status, False, detail, "Optional: codex mcp add pdf-reader -- npx @sylphx/pdf-reader-mcp"))
    return checks


def read_serena_roots(path: Path) -> tuple[int, int, str]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return 0, 0, f"cannot read {path.name}: {exc}"
    roots = data.get("roots")
    if not isinstance(roots, list):
        return 0, 0, "roots field is missing or invalid"
    existing = 0
    suitable = 0
    for item in roots:
        if not isinstance(item, dict):
            continue
        raw_path = item.get("path")
        root_path = path.parents[1] / raw_path if isinstance(raw_path, str) else None
        if root_path and root_path.exists():
            existing += 1
        if item.get("serena_suitable") is True:
            suitable += 1
    return existing, suitable, f"{existing}/{len(roots)} roots exist; {suitable} marked suitable"


def check_serena(ctx: Context) -> ToolCheck:
    repo_config = ctx.root / ".serena" / "project.yml"
    mcp_detail = ""
    mcp_list = codex_mcp_list()
    if mcp_list is not None:
        code, output = mcp_list
        if code == 0:
            mcp_detail = "; serena MCP listed" if "serena" in output.lower() else "; serena MCP not listed"
    if ctx.round_dir is None:
        status = "PASS" if repo_config.is_file() else "INFO"
        return ToolCheck("serena", "Serena", status, False, f"repo config {'present' if repo_config.is_file() else 'missing'}{mcp_detail}")
    roots_path = ctx.round_dir / "work" / "serena_roots.json"
    if roots_path.is_file():
        existing, suitable, detail = read_serena_roots(roots_path)
        status = "PASS" if existing and suitable else "WARN"
        return ToolCheck("serena", "Serena", status, False, f"{detail}{mcp_detail}")
    status = "WARN" if ctx.code_relevant else "INFO"
    return ToolCheck("serena", "Serena", status, False, f"work/serena_roots.json missing{mcp_detail}", "Run scripts/prepare-code-workspace before code-heavy reviews when source archives are present.")


def check_optional_commands() -> list[ToolCheck]:
    checks: list[ToolCheck] = []
    for command, purpose in OPTIONAL_COMMANDS:
        path = command_path(command)
        if not path:
            checks.append(ToolCheck(command, command, "INFO", False, f"not found ({purpose}; optional)"))
            continue
        if FAST_MODE:
            checks.append(ToolCheck(command, command, "PASS", False, f"found at {path}; version skipped in fast mode"))
            continue
        code, output = run([command, "--version"], timeout=5)
        detail = first_version_line(output) if code == 0 and output else f"found at {path}"
        checks.append(ToolCheck(command, command, "PASS", False, detail))
    return checks


def collect_checks(ctx: Context) -> list[ToolCheck]:
    checks = [
        check_git(ctx.root),
        check_python(),
        check_pdftotext(ctx),
        check_gh(ctx),
    ]
    checks.extend(check_node_pdf_reader(ctx))
    checks.append(check_serena(ctx))
    checks.extend(check_optional_commands())
    return checks


def summary(checks: list[ToolCheck]) -> str:
    counts = {status: sum(1 for check in checks if check.status == status) for status in ("PASS", "WARN", "FAIL", "INFO")}
    blockers = [check for check in checks if check.status == "FAIL"]
    return (
        "Tooling preflight: "
        + ("FAIL" if blockers else "OK")
        + f" ({counts['PASS']} pass, {counts['WARN']} warn, {counts['INFO']} info, {counts['FAIL']} fail)"
    )


def print_text(checks: list[ToolCheck], *, summary_only: bool) -> None:
    print(summary(checks))
    if summary_only:
        blockers = [check for check in checks if check.status == "FAIL"]
        if blockers:
            print("Blockers: " + "; ".join(f"{check.label}: {check.detail}" for check in blockers))
        return
    for check in checks:
        required = "required" if check.required else "optional"
        line = f"- {check.status} {check.label} ({required}): {check.detail}"
        if check.remediation and check.status in {"FAIL", "WARN"}:
            line += f" [{check.remediation}]"
        print(line)


def main(argv: list[str]) -> int:
    global FAST_MODE
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fast", action="store_true", help="skip slow optional version probes for case-doctor style use")
    parser.add_argument("--json", action="store_true", help="write machine-readable JSON")
    parser.add_argument("--summary", action="store_true", help="write only the one-line summary and blockers")
    parser.add_argument("case_id", nargs="?")
    parser.add_argument("round_id", nargs="?")
    args = parser.parse_args(argv[1:])
    FAST_MODE = args.fast

    root = repo_root()
    ctx = build_context(root, args.case_id, args.round_id)
    checks = collect_checks(ctx)

    if args.json:
        payload: dict[str, Any] = {
            "schema": "tooling-preflight-v1",
            "case_id": ctx.case_id,
            "round_id": ctx.round_id,
            "summary": summary(checks),
            "checks": [asdict(check) for check in checks],
        }
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print_text(checks, summary_only=args.summary)
    return 1 if any(check.status == "FAIL" for check in checks) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
