#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_prefix="__opponent_materials_smoke_$$"
created_cases=()

cleanup() {
  local case_id
  for case_id in "${created_cases[@]}"; do
    rm -rf "$repo_root/cases/$case_id"
  done
  rm -f /tmp/check-opponent-materials.out /tmp/check-opponent-materials.err
}
trap cleanup EXIT

make_case() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  local write_current="${3:-yes}"

  created_cases+=("$case_id")
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/notes"
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/outputs"
  {
    echo "Case ID: $case_id"
    echo "Work type: BP"
    echo "Academic year: 2025/2026"
    echo "Reviewer profile: default"
  } >"$repo_root/cases/$case_id/case.md"

  if [[ "$write_current" == "yes" ]]; then
    echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
  fi

  cat >"$repo_root/cases/$case_id/rounds/$round_id/notes/assignment.md" <<'EOF'
# Assignment Context

## Formal Assignment Artifacts

- Official assignment is embedded in the submitted thesis PDF.

## Formal Assignment Text Or Summary

1. Study relevant methods.
2. Design and implement a working prototype.
3. Evaluate the solution on available data.

## Private Assignment Notes For Student

None.

## Assignment Coverage Hints

- Check assignment coverage against the thesis text and code.
EOF
}

replace_text() {
  local file="$1"
  local old="$2"
  local new="$3"
  python3 - "$file" "$old" "$new" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
old = sys.argv[2]
new = sys.argv[3]
text = path.read_text(encoding="utf-8")
if old not in text:
    raise SystemExit(f"Missing expected smoke text: {old}")
path.write_text(text.replace(old, new, 1), encoding="utf-8")
PY
}

write_valid_materials() {
  local output="$1"
  cat >"$output" <<'EOF'
# Revidovane podklady pro oponentsky posudek

## 1. Rozsah kontroly

Kontrola zahrnula renderovane PDF, extrahovany text, assignment summary, README,
zdrojovy kod v `work/code/src/`, vysledkovou tabulku a interni evidence review.
Kod nebyl spusten nad plnymi daty a video nebylo prehrano; to jsou hlavni
omezeni kontroly. Bez dalsich omezeni byly overeny struktura prace, zadani,
zakladni artefakty a konkretni tvrzeni v hlavnim textu.

## 2. Strucna mapa prace

Prace navrhuje a implementuje prototyp pro zpracovani obrazovych dat. Text
obsahuje uvod, navrh, realizaci, experimenty a zaver. Kod a README dokladaji
existenci hlavni implementacni casti.

## 3. Splneni zadani

| Bod zadani | Stav | Evidence | Kalibrace |
|---|---|---|---|
| 1. Study relevant methods | Splneno | Kapitola 2 a bibliography prace. | Bez zasadni vyhrady. |
| 2. Implement prototype | Splneno s vyhradou | README, `main.py` a zadani bod 2. | Dulezite pro realizacni vystup. |
| 3. Evaluate solution | Castecne splneno | Kapitola 5, tabulka 2 a vysledky experimentu. | Slabsi reprodukovatelnost. |

## 4. Technicke jadro prace vysvetlene oponentovi

Technicke jadro tvori klasicka pipeline s vlastni orchestrace zpracovani dat.
Pro BP jde o smysluplny implementacni rozsah, ale cast vyhodnoceni zustava
prototypova a neni plne automatizovana.

## 5. Mapa textu, kodu a artefaktu

| Oblast | Evidence | Stav |
|---|---|---|
| Text prace | `extracted/thesis.txt` a kapitola 2 | Dostupne. |
| Kod | `work/code/src/main.py` a README | Inspektovatelne. |
| Vysledky | Tabulka 2 a vysledkove obrazky | Castecne overeno. |

## 6. Evidence ledger: hlavni tvrzeni a opora

| Tvrzeni | Znacka jistoty | Opora | Dopad na posudek | Pouzit do posudku? |
|---|---|---|---|---|
| Student implementoval vlastni prototyp. | [FAKT] | README, `main.py` a kapitola 4. | Pozitivni realizacni bod. | Ano. |
| Vyhodnoceni je vecne relevantni, ale omezeně reprodukovatelne. | [INTERPRETACE] | Kapitola 5, tabulka 2 a chybejici metricke skripty. | Stredni vyhrada. | Ano. |
| Plny runtime nebyl overen. | [NEOVERENO] | Scope section a chybejici smoke dataset. | Nutna opatrnost ve formulaci. | Ano. |

## 7. Silne stranky

- Prace ma konkretni implementacni vystup dolozeny README a zdrojovym kodem.
- Text obsahuje smysluplnou strukturu od metod po vysledky.
- Student uvadi omezeni experimentu a neprezentuje vysledky jako univerzalni.

## 8. Hlavni rizika a nedostatky

| Priorita | Tvrzeni | Evidence | Dopad | Mozna formulace do posudku |
|---|---|---|---|---|
| P1 | Reprodukovatelnost vysledku neni primo pripravena. | README, kapitola 5 a chybejici metricke skripty. | Snizuje overitelnost. | "Vysledky nejsou z dodanych zdroju snadno reprodukovatelne." |
| P2 | Kod ma prototypova omezeni. | `main.py`, chybove stavy a README. | Snizuje obecnost reseni. | "Kod pusobi jako funkcni prototyp." |

## 9. Pokryti polozek IS a navrhy formulaci

| Polozka IS | Stav | Evidence | Dopad | Mozna formulace |
|---|---|---|---|---|
| Narocnost zadani | Stredni | Zadani a technicke metody. | Korekcni faktor. | "Zadani hodnotim jako stredne narocne." |
| Rozsah splneni zadani | Splneno s vyhradou | Zadani bod 2 a kapitola 4. | Vyssi. | "Zadani bylo naplneno s vyhradami." |
| Rozsah technicke zpravy | Dostatecny | Kapitoly 2 az 5. | Stredni. | "Zprava pokryva hlavni principy." |
| Prezentacni uroven | Dobra | Struktura textu a tabulka 2. | Stredni. | "Text je prevazne citelny." |
| Formalni uprava | Bez zasadniho nalezu | PDF a tabulky. | Nizky. | "Formalni stranka neni hlavni slabina." |
| Prace s literaturou | Relevantni s rezervou | Bibliography a kapitola 2. | Stredni. | "Literatura je relevantni, ale mohla byt vice vyuzita." |
| Realizacni vystup | Funkcni prototyp | README, `main.py` a vysledky. | Vyssi. | "Realizace je funkcni prototyp." |
| Vyuzitelnost vysledku | Orientacni prototyp | Zaver a vysledkova kapitola. | Stredni. | "Vysledek je vyuzitelny hlavne jako prototyp." |
| Celkove hodnoceni | Dobre az velmi dobre | Kombinace zadani, kodu a vysledku. | Synteticke. | "Celkove jde o obhajitelny BP vystup." |

## 10. Technicka spravnost a realizacni vystup

Text-code consistency je v zakladnich tvrzenich dobra. Kod podporuje popis
implementacni pipeline, ale chybi samostatny reprodukcni postup pro metriky a
runtime chovani zustalo v teto kontrole neoverene.

## 11. Experimenty, vysledky a reprodukovatelnost

Experimenty jsou tematicky vhodne a maji konkretni tabulkove vysledky. Slabsi je
absence baseline a chybejici skript, ktery by ciselne vysledky znovu vytvoril.

## 12. Text, struktura, formalni stranka a literatura

Text je strukturovany a obhajitelny. Literatura je relevantni, ale cast
srovnani s existujicimi resenimi by mela byt podrobnejsi. Formalni stranka
nebyla detailne jazykove kontrolovana.

## 13. Orientacni kalibrace hodnoceni

- Konzervativni interval: 70-76 bodu, pokud bude hlavni vaha na reprodukovatelnosti.
- Standardni interval: 76-82 bodu, pokud se oceni funkcni prototyp a priznana omezeni.
- Mirnejsi interval: 82-86 bodu, pokud se prototypova omezeni budou brat jako BP uroven.

Nejlepe obhajitelny interval je 76-82 bodu.

## 14. Navrhy otazek k obhajobe

1. Jak presne lze reprodukovat vysledky z tabulky 2?
2. Co by bylo potreba doplnit, aby byl prototyp robustnejsi?
3. Ktere casti reseni jsou vase vlastni a ktere primo zavisi na knihovnich metodach?

## 15. Rucni kontroly pred napsanim posudku

- Spustit maly smoke test nad pripravenym datasetem a zaznamenat vysledek.
- Otevrit vysledkove obrazky a porovnat je s tabulkou 2.
- Zkontrolovat video nebo poster, pokud maji ovlivnit hodnoceni prezentace.
EOF
}

expect_success() {
  local name="$1"
  shift

  if ! "$@" >/tmp/check-opponent-materials.out 2>/tmp/check-opponent-materials.err; then
    echo "Expected success but failed: $name" >&2
    cat /tmp/check-opponent-materials.err >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift

  if "$@" >/tmp/check-opponent-materials.out 2>/tmp/check-opponent-materials.err; then
    echo "Expected failure but passed: $name" >&2
    cat /tmp/check-opponent-materials.out >&2
    exit 1
  fi
}

case_id="${case_prefix}_valid"
make_case "$case_id"
write_valid_materials "$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
expect_success "valid reviewed opponent materials pass" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_escaped_pipe_autolink"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "README, \`main.py\` a zadani bod 2." "README \\| \`main.py\` a zadani bod 2; viz <https://example.com/docs>."
expect_success "escaped pipe and autolink pass" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_explicit_round"
make_case "$case_id" "round-b" "no"
write_valid_materials "$repo_root/cases/$case_id/rounds/round-b/outputs/oponent_podklady_revidovane.md"
expect_success "explicit round works without current-round.txt" "$repo_root/scripts/check-opponent-materials" "$case_id" "round-b"

case_id="${case_prefix}_missing_output"
make_case "$case_id"
expect_failure "missing output fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_missing_heading"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "## 8. Hlavni rizika a nedostatky" "## 8. Rizika"
expect_failure "missing expected heading fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_missing_scope_limit"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "Kod nebyl spusten nad plnymi daty a video nebylo prehrano; to jsou hlavni
omezeni kontroly. Bez dalsich omezeni byly overeny struktura prace, zadani,
zakladni artefakty a konkretni tvrzeni v hlavnim textu." "Kontrola zahrnula hlavni prameny, text prace, kod, README a vysledky. Vystup shrnuje technicke jadro, hlavni prinosy a doporucenou bodovou kalibraci pro posudek."
expect_failure "missing scope limitation fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_missing_assignment_table"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
python3 - "$materials" <<'PY'
import pathlib
import re
import sys
path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
text = re.sub(r"\| Bod zadani \|.*?\n(?=## 4\.)", "Bez tabulky.\n\n", text, flags=re.S)
path.write_text(text, encoding="utf-8")
PY
expect_failure "missing assignment table fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_bad_confidence"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "[INTERPRETACE]" "[JISTE]"
expect_failure "unknown confidence label fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_generic_p1_evidence"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "README, kapitola 5 a chybejici metricke skripty." "text"
expect_failure "generic P1 evidence fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_too_many_risks"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
python3 - "$materials" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
old = '| P2 | Kod ma prototypova omezeni. | `main.py`, chybove stavy a README. | Snizuje obecnost reseni. | "Kod pusobi jako funkcni prototyp." |'
new = """| P2 | Kod ma prototypova omezeni. | `main.py`, chybove stavy a README. | Snizuje obecnost reseni. | "Kod pusobi jako funkcni prototyp." |
| P2 | Dokumentace je kratka. | README a kapitola 4. | Snizuje reprodukovatelnost. | "Dokumentace je kratka." |
| P2 | Testy chybi. | README a zdrojovy kod. | Snizuje overitelnost. | "Testy nejsou dolozene." |
| P2 | Baseline chybi. | Kapitola 5 a tabulka 2. | Snizuje silu vyhodnoceni. | "Baseline chybi." |
| P2 | Data nejsou popsana. | Kapitola 5 a dataset section. | Snizuje kontext. | "Data mohla byt popsana lepe." |
| P2 | Chybove stavy jsou slabe. | `main.py` a README. | Snizuje robustnost. | "Chybove stavy jsou slabe." |
| P2 | Literatura je uzka. | Kapitola 2 a bibliography. | Snizuje zasazeni. | "Literatura je uzka." |
| P2 | Zaver je obecny. | Zaver a vysledkova kapitola. | Snizuje presnost. | "Zaver je obecny." |"""
if old not in text:
    raise SystemExit(f"Missing expected smoke text: {old}")
path.write_text(text.replace(old, new, 1), encoding="utf-8")
PY
expect_failure "too many risk rows fail" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_missing_interval"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
python3 - "$materials" <<'PY'
import pathlib
import re
import sys
path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
text = re.sub(
    r"## 13\. Orientacni kalibrace hodnoceni.*?(?=## 14\.)",
    "## 13. Orientacni kalibrace hodnoceni\n\nDoporuceny vysledek je 78 bodu.\n\n",
    text,
    flags=re.S,
)
path.write_text(text, encoding="utf-8")
PY
expect_failure "single score calibration fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_few_questions"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
python3 - "$materials" <<'PY'
import pathlib
import re
import sys
path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
text = re.sub(
    r"## 14\. Navrhy otazek k obhajobe.*?(?=## 15\.)",
    "## 14. Navrhy otazek k obhajobe\n\n1. Jak presne lze reprodukovat vysledky z tabulky 2?\n\n",
    text,
    flags=re.S,
)
path.write_text(text, encoding="utf-8")
PY
expect_failure "too few defense questions fail" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_few_manual_checks"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
python3 - "$materials" <<'PY'
import pathlib
import re
import sys
path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
text = re.sub(
    r"## 15\. Rucni kontroly pred napsanim posudku.*",
    "## 15. Rucni kontroly pred napsanim posudku\n\n- Zkontrolovat.\n",
    text,
    flags=re.S,
)
path.write_text(text, encoding="utf-8")
PY
expect_failure "too few manual checks fail" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_case_id_leak"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "Prace navrhuje" "Case $case_id navrhuje"
expect_failure "exact case id leak fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_round_id_leak"
make_case "$case_id" "20260429-154605-opponent-pipeline-test"
materials="$repo_root/cases/$case_id/rounds/20260429-154605-opponent-pipeline-test/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "Prace navrhuje" "Round 20260429-154605-opponent-pipeline-test navrhuje"
expect_failure "exact round id leak fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

case_id="${case_prefix}_draft_leak"
make_case "$case_id"
materials="$repo_root/cases/$case_id/rounds/round-a/outputs/oponent_podklady_revidovane.md"
write_valid_materials "$materials"
replace_text "$materials" "Prace navrhuje" "Prace navrhuje, viz work/oponent_podklady_draft.md"
expect_failure "draft artifact leak fails" "$repo_root/scripts/check-opponent-materials" "$case_id"

echo "Opponent materials smoke passed"
