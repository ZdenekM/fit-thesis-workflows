replace_text "$round_dir/work/opponent_report_revision_request.json" "Synthetic revision request." "Changed revision request."
expect_failure "stale trace revision request binding fails" "$repo_root/scripts/check-opponent-report" "$case_id" round-a
expect_output "revision_request_sha256 is stale"

echo "Opponent report smoke passed"
