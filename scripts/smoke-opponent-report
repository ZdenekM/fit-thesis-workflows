#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_prefix="__opponent_report_smoke_$$"
created_cases=()
out_file="/tmp/opponent-report-smoke.$$.out"
err_file="/tmp/opponent-report-smoke.$$.err"

cleanup() {
  local case_id
  rm -f "$out_file" "$err_file"
  for case_id in "${created_cases[@]}"; do
    rm -rf "$repo_root/cases/$case_id"
  done
}
trap cleanup EXIT

make_case() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  created_cases+=("$case_id")
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/inputs" \
    "$repo_root/cases/$case_id/rounds/$round_id/notes" \
    "$repo_root/cases/$case_id/rounds/$round_id/outputs" \
    "$repo_root/cases/$case_id/rounds/$round_id/work"
  {
    echo "Work type: BP"
    echo "Academic year: 2025/2026"
    echo "Reviewer profile: default"
  } >"$repo_root/cases/$case_id/case.md"
  echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
  cat >"$repo_root/cases/$case_id/rounds/$round_id/notes/assignment.md" <<'EOF'
# Assignment Context

## Formal Assignment Artifacts

- Synthetic assignment artifact is available.

## Formal Assignment Text Or Summary

Synthetic assignment text.

## Private Assignment Notes For Student

Synthetic private notes.
EOF
}

write_valid_materials() {
  local target="$1"
  cat >"$target" <<'EOF'
# Revidovane podklady pro oponentsky posudek

## 1. Rozsah kontroly

Kontrola zahrnula renderovane PDF, extrahovany text, assignment summary, README,
zdrojovy kod v `work/code/src/`, vysledkovou tabulku a interni evidence review.
Kod nebyl spusten nad plnymi daty; to je hlavni omezeni kontroly.

## 2. Strucna mapa prace

Prace navrhuje a implementuje prototyp pro zpracovani obrazovych dat.

## 3. Splneni zadani

| Bod zadani | Stav | Evidence | Kalibrace |
|---|---|---|---|
| 1. Study relevant methods | Splneno | Kapitola 2 a bibliography prace. | Bez zasadni vyhrady. |
| 2. Implement prototype | Splneno s vyhradou | README, `main.py` a zadani bod 2. | Dulezite pro realizacni vystup. |
| 3. Evaluate solution | Castecne splneno | Kapitola 5, tabulka 2 a vysledky experimentu. | Slabsi reprodukovatelnost. |

## 4. Technicke jadro prace vysvetlene oponentovi

Technicke jadro tvori klasicka pipeline s vlastni orchestrace zpracovani dat.

## 5. Mapa textu, kodu a artefaktu

| Oblast | Evidence | Stav |
|---|---|---|
| Text prace | `extracted/thesis.txt` a kapitola 2 | Dostupne. |
| Kod | `work/code/src/main.py` a README | Inspektovatelne. |

## 6. Evidence ledger: hlavni tvrzeni a opora

| Tvrzeni | Znacka jistoty | Opora | Dopad na posudek | Pouzit do posudku? |
|---|---|---|---|---|
| Student implementoval vlastni prototyp. | [FAKT] | README, `main.py` a kapitola 4. | Pozitivni realizacni bod. | Ano. |
| Vyhodnoceni je vecne relevantni, ale omezeně reprodukovatelne. | [INTERPRETACE] | Kapitola 5, tabulka 2 a chybejici metricke skripty. | Stredni vyhrada. | Ano. |
| Plny runtime nebyl overen. | [NEOVERENO] | Scope section a chybejici smoke dataset. | Nutna opatrnost ve formulaci. | Ano. |

## 7. Silne stranky

- Prace ma konkretni implementacni vystup dolozeny README a zdrojovym kodem.
- Text obsahuje smysluplnou strukturu od metod po vysledky.
- Student uvadi omezeni experimentu a neprezentuje vysledky jako univerzalni.

## 8. Hlavni rizika a nedostatky

| Priorita | Tvrzeni | Evidence | Dopad | Mozna formulace do posudku |
|---|---|---|---|---|
| P1 | Reprodukovatelnost vysledku neni primo pripravena. | README, kapitola 5 a chybejici metricke skripty. | Snizuje overitelnost. | "Vysledky nejsou z dodanych zdroju snadno reprodukovatelne." |

## 9. Pokryti polozek IS a navrhy formulaci

| Polozka IS | Stav | Evidence | Dopad | Mozna formulace |
|---|---|---|---|---|
| Narocnost zadani | Stredni | Zadani a technicke metody. | Korekcni faktor. | "Zadani hodnotim jako stredne narocne." |
| Rozsah splneni zadani | Splneno s vyhradou | Zadani bod 2 a kapitola 4. | Vyssi. | "Zadani bylo naplneno s vyhradami." |
| Rozsah technicke zpravy | Dostatecny | Kapitoly 2 az 5. | Stredni. | "Zprava pokryva hlavni principy." |
| Prezentacni uroven | Dobra | Struktura textu a tabulka 2. | Stredni. | "Text je prevazne citelny." |
| Formalni uprava | Bez zasadniho nalezu | PDF a tabulky. | Nizky. | "Formalni stranka neni hlavni slabina." |
| Prace s literaturou | Relevantni s rezervou | Bibliography a kapitola 2. | Stredni. | "Literatura je relevantni, ale mohla byt vice vyuzita." |
| Realizacni vystup | Funkcni prototyp | README, `main.py` a vysledky. | Vyssi. | "Realizace je funkcni prototyp." |
| Vyuzitelnost vysledku | Orientacni prototyp | Zaver a vysledkova kapitola. | Stredni. | "Vysledek je vyuzitelny hlavne jako prototyp." |
| Celkove hodnoceni | Dobre az velmi dobre | Kombinace zadani, kodu a vysledku. | Synteticke. | "Celkove jde o obhajitelny BP vystup." |

## 10. Technicka spravnost a realizacni vystup

Text-code consistency je v zakladnich tvrzenich dobra.

## 11. Experimenty, vysledky a reprodukovatelnost

Experimenty jsou tematicky vhodne a maji konkretni tabulkove vysledky.

## 12. Text, struktura, formalni stranka a literatura

Text je strukturovany a obhajitelny.

## 13. Orientacni kalibrace hodnoceni

- Konzervativni interval: 70-76 bodu, pokud bude hlavni vaha na reprodukovatelnosti.
- Standardni interval: 76-82 bodu, pokud se oceni funkcni prototyp a priznana omezeni.
- Mirnejsi interval: 82-86 bodu, pokud se prototypova omezeni budou brat jako BP uroven.

Nejlepe obhajitelny interval je 76-82 bodu.

## 14. Navrhy otazek k obhajobe

1. Jak presne lze reprodukovat vysledky z tabulky 2?
2. Co by bylo potreba doplnit, aby byl prototyp robustnejsi?
3. Ktere casti reseni jsou vase vlastni a ktere primo zavisi na knihovnich metodach?

## 15. Rucni kontroly pred napsanim posudku

- Spustit maly smoke test nad pripravenym datasetem a zaznamenat vysledek.
- Otevrit vysledkove obrazky a porovnat je s tabulkou 2.
- Zkontrolovat video nebo poster, pokud maji ovlivnit hodnoceni prezentace.
EOF
}

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift
  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    exit 1
  fi
}

expect_output() {
  local needle="$1"
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

replace_text() {
  local file="$1"
  local old="$2"
  local new="$3"
  python3 - "$file" "$old" "$new" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
old = sys.argv[2]
new = sys.argv[3]
text = path.read_text(encoding="utf-8")
if old not in text:
    raise SystemExit(f"Missing expected text: {old}")
path.write_text(text.replace(old, new, 1), encoding="utf-8")
PY
}

file_digest() {
  python3 - "$1" <<'PY'
import hashlib
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
if not path.is_file():
    print("missing")
else:
    print(hashlib.sha256(path.read_bytes()).hexdigest())
PY
}

calibrate_draft() {
  local draft="$1"
  replace_text "$draft" "Stav: pracovní draft pro kontrolu oponentem; před vložením do IS ověřte bodové hodnocení a formulace." "Stav: připraveno pro nezávislou kontrolu oponentem."
  replace_text "$draft" "Náročnost zadání: k ručnímu výběru z nabídky IS" "Náročnost zadání: obtížnější zadání"
  replace_text "$draft" "Rozsah splnění požadavků zadání: k ručnímu výběru z nabídky IS" "Rozsah splnění požadavků zadání: zadání splněno s drobnými výhradami"
  replace_text "$draft" "Rozsah technické zprávy: k ručnímu výběru z nabídky IS" "Rozsah technické zprávy: je v obvyklém rozmezí"
  replace_text "$draft" "Prezentační úroveň technické zprávy: k ručnímu zadání bodů 0-100" "Prezentační úroveň technické zprávy: 80 bodů"
  replace_text "$draft" "Formální úprava technické zprávy: k ručnímu zadání bodů 0-100" "Formální úprava technické zprávy: 80 bodů"
  replace_text "$draft" "Práce s literaturou: k ručnímu zadání bodů 0-100" "Práce s literaturou: 80 bodů"
  replace_text "$draft" "Realizační výstup: k ručnímu zadání bodů 0-100" "Realizační výstup: 80 bodů"
  replace_text "$draft" "Bodové hodnocení: k ruční kalibraci podle splnění zadání, technické kvality, ověřitelnosti výsledků a rizik níže." "Body: 80"
  replace_text "$draft" "Navržená známka: k ruční kalibraci ve stejné interpretaci jako bodové hodnocení." "Známka: B"
  replace_text "$draft" "Děkuji za zpracovanou práci. Veřejné hodnocení výše shrnuje hlavní důvody bodového hodnocení a známky. Pro neveřejný komentář studentovi zde stručně vysvětlete, co se podle vás povedlo, proč hodnocení není vyšší, co si má student připravit k obhajobě a jaké konkrétní kroky by mu pomohly při dalším rozvoji práce. Neuvádějte interní cesty, hash hodnoty ani auditní detaily; pište věcně, přímo a podpůrně." "Děkuji za zpracovanou práci. Silnou stránkou je funkční prototyp a přiměřené pokrytí zadání. Hodnocení není vyšší hlavně kvůli slabší reprodukovatelnosti experimentů a méně přesnému textu. K obhajobě doporučuji připravit konkrétní metodiku testování, stručnou ukázku výsledků a jasné oddělení vlastního přínosu od použitých knihoven."
}

complete_manifest_for_smoke() {
  local case_id="$1"
  local round_id="$2"
  local round_dir="$repo_root/cases/$case_id/rounds/$round_id"
  local manifest="$round_dir/work/review_manifest.json"
  local coverage="$round_dir/work/agent_coverage.json"

  python3 - "$manifest" <<'PY'
import json
import pathlib
import sys
import hashlib

path = pathlib.Path(sys.argv[1])
manifest = json.loads(path.read_text(encoding="utf-8"))
round_dir = path.parent.parent

def sha256_file(file_path):
    digest = hashlib.sha256()
    with file_path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

for artifact in manifest["artifacts"]:
    if artifact["path"] == "outputs/oponent_podklady_revidovane.md":
        basis_path = "work/oponent_podklady_draft.md"
        approval_record_path = "work/reviews/opponent_materials_review.json"
        basis = round_dir / basis_path
        basis.parent.mkdir(parents=True, exist_ok=True)
        if not basis.is_file():
            basis.write_text("# Smoke opponent materials draft\n", encoding="utf-8")
        approval = round_dir / approval_record_path
        approval.parent.mkdir(parents=True, exist_ok=True)
        approval_payload = {
            "case_id": manifest["case_id"],
            "round_id": manifest["round_id"],
            "workflow_profile": "opponent_review",
            "reviewer_role": "thesis-opponent-materials-review",
            "reviewer_agent": "opponent-materials-reviewer",
            "verdict": "approved",
            "blocking_findings_count": 0,
            "reviewed_artifact_path": "outputs/oponent_podklady_revidovane.md",
            "reviewed_artifact_sha256": artifact["artifact_sha256"],
            "review_basis_path": basis_path,
            "review_basis_sha256": sha256_file(basis),
            "checks_observed": ["check-round-ready", "check-opponent-materials", "check-opponent-report:canonical"],
            "limitations": ["None."],
            "timestamp": "2026-05-04T00:01:00Z",
        }
        approval.write_text(json.dumps(approval_payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        artifact["generated_by"] = [
            {
                "role": "thesis-opponent-materials",
                "agent": "opponent-materials-generator",
                "contribution": "generation",
                "notes": "Smoke generated source materials.",
            }
        ]
        artifact["independent_review"] = {
            "status": "reviewed",
            "reviewer_role": "thesis-opponent-materials-review",
            "reviewer_agent": "opponent-materials-reviewer",
            "reviewed_at": "2026-05-04T00:01:00Z",
            "reviewed_hash": artifact["artifact_sha256"],
            "covered_by_artifact": "",
            "used_findings": "",
            "exception": "",
            "notes": "Smoke review passed.",
            "review_basis_path": basis_path,
            "review_basis_sha256": approval_payload["review_basis_sha256"],
            "approval_record_path": approval_record_path,
        }
        artifact["limitations"] = ["None."]
for check in manifest["helper_checks"]:
    if check["check"] == "check-review-manifest":
        check["status"] = "not_applicable"
        check["exit_code"] = None
        check["checked_at"] = ""
    else:
        check["status"] = "passed"
        check["exit_code"] = 0
        check["checked_at"] = "2026-05-04T00:02:00Z"
path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
  "$repo_root/scripts/init-review-manifest" "$case_id" "$round_id" >/dev/null
  python3 - "$manifest" "$coverage" <<'PY'
import json
import hashlib
import pathlib
import sys

manifest_path = pathlib.Path(sys.argv[1])
coverage_path = pathlib.Path(sys.argv[2])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
for check in manifest["helper_checks"]:
    if check["check"] == "check-review-manifest":
        check["status"] = "not_applicable"
        check["exit_code"] = None
        check["checked_at"] = ""
    else:
        check["status"] = "passed"
        check["exit_code"] = 0
        check["checked_at"] = "2026-05-04T00:02:00Z"
manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

coverage = json.loads(coverage_path.read_text(encoding="utf-8"))
for role in coverage["roles"]:
    if role["role"] == "typography_formal":
        role["status"] = "blocked"
        role["output_evidence"] = []
        role["typed_limitation"] = {
            "type": "manual_review_required",
            "role": role["role"],
            "trigger": role["trigger"],
            "required_for": role["required_for"],
            "description": "Synthetic smoke case has no standalone typography/formal review artifact.",
        }
        role["notes"] = "Blocked intentionally in smoke data."
coverage_path.write_text(json.dumps(coverage, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
coverage_hash = hashlib.sha256(coverage_path.read_bytes()).hexdigest()
for item in manifest.get("supporting_work_artifacts", []):
    if item.get("path") == "work/agent_coverage.json":
        item["artifact_sha256"] = coverage_hash
for check in manifest.get("helper_checks", []):
    if check.get("check") == "check-agent-coverage":
        target_sha256 = check.setdefault("target_sha256", {})
        target_sha256["work/agent_coverage.json"] = coverage_hash
manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

write_report_review_feedback() {
  local target="$1"
  cat >"$target" <<'EOF'
# Review oponentského posudku

## Verdikt

Posudek je po nezávislé kontrole připraven k pre-submission closeoutu.

## Kontroly

- Clean návrh odpovídá veřejným IS položkám a obsahuje neveřejný komentář pro studenta.
- Body, známka a slovní hodnocení jsou ve vzájemně obhajitelném vztahu.
- Obranné otázky jsou věcně navázané na reviewed materials a trace.

## Limitace

Smoke fixture používá syntetická data a neověřuje reálné PDF.
EOF
}

register_report_review_role_outputs() {
  local case_id="$1"
  local round_id="$2"
  local round_dir="$repo_root/cases/$case_id/rounds/$round_id"

  mkdir -p "$round_dir/work/opponent_packets"
  cat >"$round_dir/work/opponent_packets/text_structure_assignment_findings.md" <<'EOF'
# Text Structure And Assignment Findings

## Synthesis Handoff

- Synthetic smoke confirms that assignment/report structure was inspected before report review closeout.
EOF

  expect_success "register text structure role output" \
    "$repo_root/scripts/register-review-artifact" "$case_id" "$round_id" \
    work/opponent_packets/text_structure_assignment_findings.md \
    --preset none \
    --role thesis-opponent-materials \
    --agent smoke-text-structure-agent \
    --review-scope internal_only \
    --review-status not_required

  expect_success "register current evidence snapshot role output" \
    "$repo_root/scripts/register-review-artifact" "$case_id" "$round_id" \
    work/current_evidence_snapshot.json \
    --preset none \
    --role mechanical-validator-backed-helper \
    --agent smoke-current-evidence-helper \
    --review-scope internal_only \
    --review-status not_required

  expect_success "register opponent report trace role output" \
    "$repo_root/scripts/register-review-artifact" "$case_id" "$round_id" \
    work/opponent_report_trace.json \
    --preset none \
    --role mechanical-validator-backed-helper \
    --agent smoke-report-trace-helper \
    --review-scope internal_only \
    --review-status not_required

  expect_success "register opponent report review output" \
    "$repo_root/scripts/register-review-artifact" "$case_id" "$round_id" \
    outputs/feedback_k_posudku.md \
    --role thesis-opponent-report-review \
    --agent smoke-report-review-output \
    --contribution final_review \
    --review-status reviewed \
    --reviewer-role thesis-opponent-report-review \
    --reviewer-agent smoke-report-reviewer \
    --reviewed-at 2026-05-18T12:04:00Z \
    --review-basis-path outputs/oponent_posudek_navrh.md
}

mark_optional_evidence_limitations_for_report_review() {
  local round_dir="$1"
  python3 - "$round_dir/work/review_manifest.json" "$round_dir/work/agent_coverage.json" <<'PY'
import hashlib
import json
import pathlib
import sys

manifest_path = pathlib.Path(sys.argv[1])
coverage_path = pathlib.Path(sys.argv[2])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
coverage = json.loads(coverage_path.read_text(encoding="utf-8"))
blocked_roles = {
    "literature_citation": "Synthetic smoke case has no standalone literature/citation evidence artifact.",
    "typography_formal": "Synthetic smoke case has no standalone typography/formal review artifact.",
}
for role in coverage.get("roles", []):
    role_name = role.get("role")
    if role_name not in blocked_roles:
        continue
    role["status"] = "blocked"
    role["output_evidence"] = []
    role["typed_limitation"] = {
        "type": "manual_review_required",
        "role": role_name,
        "trigger": role.get("trigger", ""),
        "required_for": role.get("required_for", []),
        "description": blocked_roles[role_name],
    }
    role["notes"] = "Blocked intentionally in smoke data."
missing = sorted(set(blocked_roles) - {role.get("role") for role in coverage.get("roles", [])})
if missing:
    raise SystemExit(f"Missing expected coverage roles: {', '.join(missing)}")
coverage_path.write_text(json.dumps(coverage, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
coverage_hash = hashlib.sha256(coverage_path.read_bytes()).hexdigest()
for item in manifest.get("supporting_work_artifacts", []):
    if item.get("path") == "work/agent_coverage.json":
        item["artifact_sha256"] = coverage_hash
for check in manifest.get("helper_checks", []):
    if check.get("check") == "check-agent-coverage":
        target_sha256 = check.setdefault("target_sha256", {})
        target_sha256["work/agent_coverage.json"] = coverage_hash
manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

assert_report_review_closeout_manifest() {
  local round_dir="$1"
  python3 - "$round_dir" <<'PY'
import json
import pathlib
import sys

round_dir = pathlib.Path(sys.argv[1])
sys.path.insert(0, str(round_dir.parents[3] / "src"))

from thesis_review_workflow.review_packets import validate_common_briefing_artifact

case_id = round_dir.parents[1].name
round_id = round_dir.name
manifest = json.loads((round_dir / "work/review_manifest.json").read_text(encoding="utf-8"))
approval = json.loads((round_dir / "work/reviews/opponent_report_review.json").read_text(encoding="utf-8"))

assert approval["review_basis_path"] == "outputs/oponent_posudek_navrh.md", approval
artifacts = {item["path"]: item for item in manifest["artifacts"]}
report_review = artifacts["outputs/feedback_k_posudku.md"]["independent_review"]
assert report_review["review_basis_path"] == "outputs/oponent_posudek_navrh.md", report_review
assert report_review["approval_record_path"] == "work/reviews/opponent_report_review.json", report_review
checks = {item["check"]: item for item in manifest["helper_checks"]}
for name in (
    "check-opponent-report:canonical",
    "check-opponent-report:clean",
    "check-agent-coverage",
):
    assert checks[name]["status"] == "passed", checks[name]
assert checks["check-review-manifest"]["status"] == "not_applicable", checks["check-review-manifest"]
briefing_hash = (round_dir / "work/common_briefing.json").read_bytes()
import hashlib

current_common_hash = hashlib.sha256(briefing_hash).hexdigest()
for item in manifest.get("supporting_work_artifacts", []):
    rel_path = item.get("path")
    if isinstance(rel_path, str) and rel_path.startswith("work/opponent_packets/"):
        assert (round_dir / rel_path).is_file(), rel_path
packet = (round_dir / "work/opponent_packets/report_review.md").read_text(encoding="utf-8")
assert "outputs/oponent_posudek_navrh.md" in packet, packet
assert f"Common briefing sha256: `{current_common_hash}`" in packet, packet
assert validate_common_briefing_artifact(round_dir, case_id=case_id, round_id=round_id) == []
PY
}

write_report_trace() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  local round_dir="$repo_root/cases/$case_id/rounds/$round_id"
  python3 - "$round_dir/work/opponent_report_trace.json" "$case_id" "$round_id" "$round_dir/outputs/oponent_podklady_revidovane.md" <<'PY'
