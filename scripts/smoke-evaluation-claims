#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_prefix="__evaluation_claims_smoke_$$"
created_cases=()
out_file="/tmp/check-evaluation-claims.$$.out"
err_file="/tmp/check-evaluation-claims.$$.err"

cleanup() {
  local case_id
  for case_id in "${created_cases[@]}"; do
    rm -rf "$repo_root/cases/$case_id"
  done
  rm -f "$out_file" "$err_file"
}
trap cleanup EXIT

make_case() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  local write_current="${3:-yes}"

  created_cases+=("$case_id")
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/extracted" \
    "$repo_root/cases/$case_id/rounds/$round_id/work"
  {
    echo "Work type: BP"
    echo "Academic year: 2025/2026"
  } >"$repo_root/cases/$case_id/case.md"

  if [[ "$write_current" == "yes" ]]; then
    echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
  fi
  printf '%s\n' 'Synthetic thesis text used only as a referenced fixture.' \
    >"$repo_root/cases/$case_id/rounds/$round_id/extracted/thesis.txt"
}

write_claims() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  local status="${3:-needs_context}"
  python3 - "$repo_root/cases/$case_id/rounds/$round_id/work/quantitative_claims.json" \
    "$case_id" "$round_id" "$status" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
case_id = sys.argv[2]
round_id = sys.argv[3]
status = sys.argv[4]
payload = {
    "schema_version": "quantitative-claims-v1",
    "case_id": case_id,
    "round_id": round_id,
    "generated_at": "2026-05-07T00:00:00Z",
    "producer_type": "agent",
    "producer_role": "quantitative-claims-reviewer",
    "producer_agent": "smoke-agent",
    "authorization_note": "Smoke test uses a synthetic agent-authored fixture.",
    "source_refs": ["extracted/thesis.txt"],
    "claims": [
        {
            "claim_id": "Q1",
            "summary": "Synthetic metric claim.",
            "kind": "metric",
            "status": status,
            "unit": "%",
            "baseline_status": "missing",
            "practical_context": "weak",
            "reproducibility_refs": [],
            "evidence_refs": ["extracted/thesis.txt"],
            "requires_reviewer_verification": True,
        }
    ],
    "limitations": [],
}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
}

expect_success_contains() {
  local name="$1"
  local pattern="$2"
  shift 2

  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$err_file" >&2
    cat "$out_file" >&2
    exit 1
  fi
  if ! grep -E "$pattern" "$out_file" "$err_file" >/dev/null; then
    echo "Expected output did not match pattern: $name" >&2
    echo "Pattern: $pattern" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure_contains() {
  local name="$1"
  local pattern="$2"
  shift 2

  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    exit 1
  fi
  if ! grep -E "$pattern" "$out_file" "$err_file" >/dev/null; then
    echo "Expected failure did not match pattern: $name" >&2
    echo "Pattern: $pattern" >&2
    cat "$err_file" >&2
    cat "$out_file" >&2
    exit 1
  fi
}

case_id="${case_prefix}_missing_artifact"
make_case "$case_id"
expect_failure_contains "missing quantitative claims artifact fails" \
  "missing structured evidence artifact" "$repo_root/scripts/check-evaluation-claims" "$case_id"

case_id="${case_prefix}_valid"
make_case "$case_id"
write_claims "$case_id"
expect_success_contains "structured quantitative claims pass" \
  "Quantitative claims structured artifact check passed" "$repo_root/scripts/check-evaluation-claims" "$case_id"
expect_success_contains "claim count is reported" \
  "Quantitative claims: 1" "$repo_root/scripts/check-evaluation-claims" "$case_id"

case_id="${case_prefix}_invalid_status"
make_case "$case_id"
write_claims "$case_id" "round-a" "strong"
expect_failure_contains "invalid claim enum fails" \
  "status must be one of" "$repo_root/scripts/check-evaluation-claims" "$case_id"

case_id="${case_prefix}_explicit_round"
make_case "$case_id" "round-b" "no"
write_claims "$case_id" "round-b"
expect_success_contains "explicit round works" \
  "Quantitative claims artifact" "$repo_root/scripts/check-evaluation-claims" "$case_id" "round-b"

case_id="${case_prefix}_missing_ref"
make_case "$case_id"
write_claims "$case_id"
rm -f "$repo_root/cases/$case_id/rounds/round-a/extracted/thesis.txt"
expect_failure_contains "missing referenced source fails" \
  "referenced file is missing" "$repo_root/scripts/check-evaluation-claims" "$case_id"

case_id="${case_prefix}_dot_round"
make_case "$case_id"
expect_failure_contains "dot-only round id fails" \
  "Invalid ROUND_ID" "$repo_root/scripts/check-evaluation-claims" "$case_id" ".."

echo "Evaluation claims smoke passed"
