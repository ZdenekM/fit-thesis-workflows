#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

bad_tracked="$(git ls-files cases | grep -v '^cases/README.md$' || true)"
if [[ -n "$bad_tracked" ]]; then
  echo "Private case data is tracked by git:" >&2
  echo "$bad_tracked" >&2
  exit 1
fi

sensitive_pattern='\.(pdf|zip|docx?|odt|tex|bib|txt|log|csv|tsv|xlsx?|ipynb|png|jpe?g|webp)$'
sensitive_tracked="$(
  git ls-files \
    | grep -E "$sensitive_pattern" \
    | grep -v '^cases/README.md$' \
    | grep -v '^templates/' \
    | grep -v '^config/supervisor-deadlines.tsv$' \
    || true
)"
if [[ -n "$sensitive_tracked" ]]; then
  echo "Potential private thesis artifacts are tracked outside ignored cases/:" >&2
  echo "$sensitive_tracked" >&2
  exit 1
fi

sensitive_untracked="$(
  git status --porcelain --untracked-files=all \
    | sed -n 's/^?? //p' \
    | grep -E "$sensitive_pattern" \
    | grep -v '^cases/' \
    | grep -v '^templates/' \
    | grep -v '^config/supervisor-deadlines.tsv$' \
    || true
)"
if [[ -n "$sensitive_untracked" ]]; then
  echo "Potential private thesis artifacts are present outside ignored cases/:" >&2
  echo "$sensitive_untracked" >&2
  exit 1
fi

if ! git check-ignore -q cases/__privacy_sentinel__/inputs/thesis.pdf; then
  echo "cases/ data is not ignored as expected" >&2
  exit 1
fi

echo "Private case workspace check passed."
