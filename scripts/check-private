#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

bad_tracked="$(git ls-files cases | grep -v '^cases/README.md$' || true)"
if [[ -n "$bad_tracked" ]]; then
  echo "Private case data is tracked by git:" >&2
  echo "$bad_tracked" >&2
  exit 1
fi

bad_profile_tracked="$(
  git ls-files profiles \
    | grep -v '^profiles/README.md$' \
    | grep -v '^profiles/default.md$' \
    || true
)"
if [[ -n "$bad_profile_tracked" ]]; then
  echo "Private reviewer profiles are tracked by git:" >&2
  echo "$bad_profile_tracked" >&2
  exit 1
fi

sensitive_pattern='\.(pdf|zip|docx?|odt|tex|bib|txt|log|csv|tsv|xlsx?|ipynb|png|jpe?g|webp)$'
private_jsonl_pattern='(^|/)visual_inventory\.jsonl$'
private_markdown_pattern='(^|/)(feedback_student|feedback_student_draft|feedback_k_posudku|revision_diff|code_consistency|code_quality_review|literature_citation_review|figure_media_review|demo_artifacts_review|reference_report_comparison|oponent_podklady|oponent_podklady_draft|oponent_podklady_revidovane)\.md$'
sensitive_tracked="$(
  git ls-files \
    | grep -E "$sensitive_pattern|$private_jsonl_pattern" \
    | grep -v '^cases/README.md$' \
    | grep -v '^templates/' \
    | grep -v '^config/supervisor-deadlines.tsv$' \
    || true
)"
if [[ -n "$sensitive_tracked" ]]; then
  echo "Potential private thesis artifacts are tracked outside ignored cases/:" >&2
  echo "$sensitive_tracked" >&2
  exit 1
fi

private_markdown_tracked="$(
  git ls-files \
    | grep -E "$private_markdown_pattern" \
    | grep -v '^cases/' \
    || true
)"
if [[ -n "$private_markdown_tracked" ]]; then
  echo "Potential private generated Markdown artifacts are tracked outside ignored cases/:" >&2
  echo "$private_markdown_tracked" >&2
  exit 1
fi

sensitive_untracked="$(
  git status --porcelain --untracked-files=all \
    | sed -n 's/^?? //p' \
    | grep -E "$sensitive_pattern|$private_jsonl_pattern" \
    | grep -v '^cases/' \
    | grep -v '^templates/' \
    | grep -v '^config/supervisor-deadlines.tsv$' \
    || true
)"
if [[ -n "$sensitive_untracked" ]]; then
  echo "Potential private thesis artifacts are present outside ignored cases/:" >&2
  echo "$sensitive_untracked" >&2
  exit 1
fi

private_markdown_untracked="$(
  git status --porcelain --untracked-files=all \
    | sed -n 's/^?? //p' \
    | grep -E "$private_markdown_pattern" \
    | grep -v '^cases/' \
    || true
)"
if [[ -n "$private_markdown_untracked" ]]; then
  echo "Potential private generated Markdown artifacts are present outside ignored cases/:" >&2
  echo "$private_markdown_untracked" >&2
  exit 1
fi

if ! git check-ignore -q cases/__privacy_sentinel__/inputs/thesis.pdf; then
  echo "cases/ data is not ignored as expected" >&2
  exit 1
fi

for ignored_profile in \
  profiles/local/default.md \
  profiles/local/test.md \
  profiles/private.md; do
  if ! git check-ignore -q "$ignored_profile"; then
    echo "$ignored_profile is not ignored as expected" >&2
    exit 1
  fi
done

for public_profile in \
  profiles/default.md \
  profiles/README.md; do
  if git check-ignore --no-index -q "$public_profile"; then
    echo "$public_profile should be trackable but is ignored" >&2
    exit 1
  fi
done

echo "Private workspace and reviewer profile check passed."
