#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_prefix="__opponent_closeout_smoke_$$"
created_cases=()
out_file="/tmp/opponent-closeout-smoke.$$.out"
err_file="/tmp/opponent-closeout-smoke.$$.err"

cleanup() {
  local case_id
  rm -f "$out_file" "$err_file"
  for case_id in "${created_cases[@]}"; do
    rm -rf "$repo_root/cases/$case_id"
  done
}
trap cleanup EXIT

make_case() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  created_cases+=("$case_id")
  mkdir -p "$repo_root/cases/$case_id/rounds/$round_id/inputs" \
    "$repo_root/cases/$case_id/rounds/$round_id/extracted" \
    "$repo_root/cases/$case_id/rounds/$round_id/notes" \
    "$repo_root/cases/$case_id/rounds/$round_id/work" \
    "$repo_root/cases/$case_id/rounds/$round_id/outputs"
  {
    echo "Work type: BP"
    echo "Academic year: 2025/2026"
    echo "Reviewer profile: default"
  } >"$repo_root/cases/$case_id/case.md"
  echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
  cat >"$repo_root/cases/$case_id/rounds/$round_id/notes/assignment.md" <<'EOF'
# Assignment Context

## Formal Assignment Artifacts

- Synthetic assignment artifact is available.

## Formal Assignment Text Or Summary

Synthetic assignment text.

## Private Assignment Notes For Student

Synthetic private notes.
EOF
}

write_valid_materials() {
  local output="$1"
  cat >"$output" <<'EOF'
# Revidovane podklady pro oponentsky posudek

## 1. Rozsah kontroly

Kontrola zahrnula renderovane PDF, extrahovany text, assignment summary, README,
zdrojovy kod v `work/code/src/`, vysledkovou tabulku a interni evidence review.
Kod nebyl spusten nad plnymi daty a video nebylo prehrano; to jsou hlavni
omezeni kontroly. Bez dalsich omezeni byly overeny struktura prace, zadani,
zakladni artefakty a konkretni tvrzeni v hlavnim textu.

## 2. Strucna mapa prace

Prace navrhuje a implementuje prototyp pro zpracovani obrazovych dat. Text
obsahuje uvod, navrh, realizaci, experimenty a zaver. Kod a README dokladaji
existenci hlavni implementacni casti.

## 3. Splneni zadani

| Bod zadani | Stav | Evidence | Kalibrace |
|---|---|---|---|
| 1. Study relevant methods | Splneno | Kapitola 2 a bibliography prace. | Bez zasadni vyhrady. |
| 2. Implement prototype | Splneno s vyhradou | README, `main.py` a zadani bod 2. | Dulezite pro realizacni vystup. |
| 3. Evaluate solution | Castecne splneno | Kapitola 5, tabulka 2 a vysledky experimentu. | Slabsi reprodukovatelnost. |

## 4. Technicke jadro prace vysvetlene oponentovi

Technicke jadro tvori klasicka pipeline s vlastni orchestrace zpracovani dat.
Pro BP jde o smysluplny implementacni rozsah, ale cast vyhodnoceni zustava
prototypova a neni plne automatizovana.

## 5. Mapa textu, kodu a artefaktu

| Oblast | Evidence | Stav |
|---|---|---|
| Text prace | `extracted/thesis.txt` a kapitola 2 | Dostupne. |
| Kod | `work/code/src/main.py` a README | Inspektovatelne. |
| Vysledky | Tabulka 2 a vysledkove obrazky | Castecne overeno. |

## 6. Evidence ledger: hlavni tvrzeni a opora

| Tvrzeni | Znacka jistoty | Opora | Dopad na posudek | Pouzit do posudku? |
|---|---|---|---|---|
| Student implementoval vlastni prototyp. | [FAKT] | README, `main.py` a kapitola 4. | Pozitivni realizacni bod. | Ano. |
| Vyhodnoceni je vecne relevantni, ale omezene reprodukovatelne. | [INTERPRETACE] | Kapitola 5, tabulka 2 a chybejici metricke skripty. | Stredni vyhrada. | Ano. |
| Plny runtime nebyl overen. | [NEOVERENO] | Scope section a chybejici smoke dataset. | Nutna opatrnost ve formulaci. | Ano. |

## 7. Silne stranky

- Prace ma konkretni implementacni vystup dolozeny README a zdrojovym kodem.
- Text obsahuje smysluplnou strukturu od metod po vysledky.
- Student uvadi omezeni experimentu a neprezentuje vysledky jako univerzalni.

## 8. Hlavni rizika a nedostatky

| Priorita | Tvrzeni | Evidence | Dopad | Mozna formulace do posudku |
|---|---|---|---|---|
| P1 | Reprodukovatelnost vysledku neni primo pripravena. | README, kapitola 5 a chybejici metricke skripty. | Snizuje overitelnost. | "Vysledky nejsou z dodanych zdroju snadno reprodukovatelne." |
| P2 | Kod ma prototypova omezeni. | `main.py`, chybove stavy a README. | Snizuje obecnost reseni. | "Kod pusobi jako funkcni prototyp." |

## 9. Pokryti polozek IS a navrhy formulaci

| Polozka IS | Stav | Evidence | Dopad | Mozna formulace |
|---|---|---|---|---|
| Narocnost zadani | Stredni | Zadani a technicke metody. | Korekcni faktor. | "Zadani hodnotim jako stredne narocne." |
| Rozsah splneni zadani | Splneno s vyhradou | Zadani bod 2 a kapitola 4. | Vyssi. | "Zadani bylo naplneno s vyhradami." |
| Rozsah technicke zpravy | Dostatecny | Kapitoly 2 az 5. | Stredni. | "Zprava pokryva hlavni principy." |
| Prezentacni uroven | Dobra | Struktura textu a tabulka 2. | Stredni. | "Text je prevazne citelny." |
| Formalni uprava | Bez zasadniho nalezu | PDF a tabulky. | Nizky. | "Formalni stranka neni hlavni slabina." |
| Prace s literaturou | Relevantni s rezervou | Bibliography a kapitola 2. | Stredni. | "Literatura je relevantni, ale mohla byt vice vyuzita." |
| Realizacni vystup | Funkcni prototyp | README, `main.py` a vysledky. | Vyssi. | "Realizace je funkcni prototyp." |
| Vyuzitelnost vysledku | Orientacni prototyp | Zaver a vysledkova kapitola. | Stredni. | "Vysledek je vyuzitelny hlavne jako prototyp." |
| Celkove hodnoceni | Dobre az velmi dobre | Kombinace zadani, kodu a vysledku. | Synteticke. | "Celkove jde o obhajitelny BP vystup." |

## 10. Technicka spravnost a realizacni vystup

Text-code consistency je v zakladnich tvrzenich dobra. Kod podporuje popis
implementacni pipeline, ale chybi samostatny reprodukcni postup pro metriky a
runtime chovani zustalo v teto kontrole neoverene.

## 11. Experimenty, vysledky a reprodukovatelnost

Experimenty jsou tematicky vhodne a maji konkretni tabulkove vysledky. Slabsi je
absence baseline a chybejici skript, ktery by ciselne vysledky znovu vytvoril.

## 12. Text, struktura, formalni stranka a literatura

Text je strukturovany a obhajitelny. Literatura je relevantni, ale cast
srovnani s existujicimi resenimi by mela byt podrobnejsi. Formalni stranka
nebyla detailne jazykove kontrolovana.

## 13. Orientacni kalibrace hodnoceni

- Konzervativni interval: 70-76 bodu, pokud bude hlavni vaha na reprodukovatelnosti.
- Standardni interval: 76-82 bodu, pokud se oceni funkcni prototyp a priznana omezeni.
- Mirnejsi interval: 82-86 bodu, pokud se prototypova omezeni budou brat jako BP uroven.

Nejlepe obhajitelny interval je 76-82 bodu.

## 14. Navrhy otazek k obhajobe

1. Jak presne lze reprodukovat vysledky z tabulky 2?
2. Co by bylo potreba doplnit, aby byl prototyp robustnejsi?
3. Ktere casti reseni jsou vase vlastni a ktere primo zavisi na knihovnich metodach?

## 15. Rucni kontroly pred napsanim posudku

- Spustit maly smoke test nad pripravenym datasetem a zaznamenat vysledek.
- Otevrit vysledkove obrazky a porovnat je s tabulkou 2.
- Zkontrolovat video nebo poster, pokud maji ovlivnit hodnoceni prezentace.
EOF
}

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift
  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    exit 1
  fi
}

expect_output() {
  local needle="$1"
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

calibrate_draft() {
  local draft="$1"
  python3 - "$draft" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
replacements = {
    "Náročnost zadání: k ručnímu výběru z nabídky IS": "Náročnost zadání: obtížnější zadání",
    "Rozsah splnění požadavků zadání: k ručnímu výběru z nabídky IS": (
        "Rozsah splnění požadavků zadání: zadání splněno s drobnými výhradami"
    ),
    "Rozsah technické zprávy: k ručnímu výběru z nabídky IS": "Rozsah technické zprávy: je v obvyklém rozmezí",
    "Prezentační úroveň technické zprávy: k ručnímu zadání bodů 0-100": (
        "Prezentační úroveň technické zprávy: 80 bodů"
    ),
    "Formální úprava technické zprávy: k ručnímu zadání bodů 0-100": "Formální úprava technické zprávy: 80 bodů",
    "Práce s literaturou: k ručnímu zadání bodů 0-100": "Práce s literaturou: 80 bodů",
    "Realizační výstup: k ručnímu zadání bodů 0-100": "Realizační výstup: 80 bodů",
    (
        "Děkuji za zpracovanou práci. Veřejné hodnocení výše shrnuje hlavní důvody bodového hodnocení a "
        "známky. Pro neveřejný komentář studentovi zde stručně vysvětlete, co se podle vás povedlo, proč "
        "hodnocení není vyšší, co si má student připravit k obhajobě a jaké konkrétní kroky by mu pomohly "
        "při dalším rozvoji práce. Neuvádějte interní cesty, hash hodnoty ani auditní detaily; pište věcně, "
        "přímo a podpůrně."
    ): (
        "Děkuji za zpracovanou práci. Silnou stránkou je funkční prototyp a přiměřené pokrytí zadání. "
        "Hodnocení není vyšší hlavně kvůli slabší reprodukovatelnosti experimentů a méně přesnému textu. "
        "K obhajobě doporučuji připravit konkrétní metodiku testování a jasné oddělení vlastního přínosu "
        "od použitých knihoven."
    ),
}
for old, new in replacements.items():
    text = text.replace(old, new)
lines = []
for line in text.splitlines():
    if line.startswith("Stav:"):
        lines.append("Stav: pripraveno pro nezavislou kontrolu oponentem.")
    elif line.startswith("Bodov"):
        lines.append(line.split(":", 1)[0] + ": 80")
    elif line.startswith("Navr"):
        lines.append(line.split(":", 1)[0] + ": B")
    else:
        lines.append(line)
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
}

mark_opponent_reviewed() {
  local round_dir="$1"
  python3 - "$round_dir" <<'PY'
import hashlib
import json
import pathlib
import sys

round_dir = pathlib.Path(sys.argv[1])
manifest_path = round_dir / "work" / "review_manifest.json"
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
for artifact in manifest["artifacts"]:
    if artifact["path"] != "outputs/oponent_podklady_revidovane.md":
        continue
    digest = artifact["artifact_sha256"]
    artifact["generated_by"] = [
        {
            "role": "thesis-opponent-materials",
            "agent": "generator-agent",
            "contribution": "generation",
            "notes": "Smoke generator.",
        }
    ]
    artifact["independent_review"] = {
        "status": "reviewed",
        "reviewer_role": "thesis-opponent-materials-review",
        "reviewer_agent": "reviewer-agent",
        "reviewed_at": "2026-05-05T00:01:00Z",
        "reviewed_hash": digest,
        "covered_by_artifact": "",
        "used_findings": "",
        "exception": "",
        "notes": "Smoke review passed.",
    }
    artifact["limitations"] = ["None."]
manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

block_typography_role() {
  local round_dir="$1"
  python3 - "$round_dir" <<'PY'
import json
import pathlib
import sys

round_dir = pathlib.Path(sys.argv[1])
coverage_path = round_dir / "work" / "agent_coverage.json"
coverage = json.loads(coverage_path.read_text(encoding="utf-8"))
for role in coverage["roles"]:
    if role["role"] != "typography_formal":
        continue
    role.update(
        {
            "status": "blocked",
            "typed_limitation": {
                "type": "not_material_to_final",
                "role": role["role"],
                "trigger": role["trigger"],
                "required_for": role["required_for"],
                "description": "Typography/formal review is not material in this smoke fixture.",
            },
            "output_evidence": [],
        }
    )
coverage_path.write_text(json.dumps(coverage, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}

write_report_trace() {
  local case_id="$1"
  local round_id="${2:-round-a}"
  local round_dir="$repo_root/cases/$case_id/rounds/$round_id"
  python3 - "$round_dir/work/opponent_report_trace.json" "$case_id" "$round_id" "$round_dir/outputs/oponent_podklady_revidovane.md" <<'PY'
import hashlib
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
case_id = sys.argv[2]
round_id = sys.argv[3]
materials_path = pathlib.Path(sys.argv[4])
round_dir = materials_path.parents[1]
repo_root = round_dir.parents[3]
for rel_path, text in {
    "extracted/thesis.txt": "Synthetic extracted thesis text with generic implementation and evaluation claims.\n",
    "notes/static-code-evidence.md": "Synthetic static-code evidence note.\n",
    "notes/run-demo-evidence.md": "Synthetic run/demo evidence limitation note.\n",
    "notes/media-inventory.md": "Synthetic media inventory note: screenshot is inventoried only.\n",
}.items():
    evidence_path = round_dir / rel_path
    evidence_path.parent.mkdir(parents=True, exist_ok=True)
    evidence_path.write_text(text, encoding="utf-8")
materials_hash = hashlib.sha256(materials_path.read_bytes()).hexdigest()
profile_sources = [
    {
        "path": "profiles/default.md",
        "sha256": hashlib.sha256((repo_root / "profiles/default.md").read_bytes()).hexdigest(),
    }
]
local_profile = repo_root / "profiles/local/default.md"
if local_profile.is_file():
    profile_sources.append(
        {
            "path": "profiles/local/default.md",
            "sha256": hashlib.sha256(local_profile.read_bytes()).hexdigest(),
        }
    )
formulations = {
    "assignment_difficulty": ("Náročnost zadání", "Zadani hodnotim jako stredne narocne."),
    "assignment_fulfillment": ("Rozsah splnění požadavků zadání", "Zadani bylo naplneno s vyhradami."),
    "technical_report_scope": ("Rozsah technické zprávy", "Zprava pokryva hlavni principy."),
    "technical_report_presentation": ("Prezentační úroveň technické zprávy", "Text je prevazne citelny."),
    "technical_report_formal_level": ("Formální úprava technické zprávy", "Formalni stranka neni hlavni slabina."),
    "literature_work": ("Práce s literaturou", "Literatura je relevantni, ale mohla byt vice vyuzita."),
    "implementation_output": ("Realizační výstup", "Realizace je funkcni prototyp."),
    "result_usability": ("Využitelnost výsledku", "Vysledek je vyuzitelny hlavne jako prototyp."),
    "overall_assessment": ("Celkové hodnocení", "Celkove jde o obhajitelny BP vystup."),
}
payload = {
    "schema_version": "opponent-report-trace-v2",
    "case_id": case_id,
    "round_id": round_id,
    "generated_at": "2026-05-07T00:00:00Z",
    "producer_type": "agent",
    "producer_role": "opponent-report-trace-reviewer",
    "producer_agent": "smoke-trace-agent",
    "authorization_note": "Smoke test uses a synthetic agent-authored fixture.",
    "source_refs": ["outputs/oponent_podklady_revidovane.md"],
    "source_materials_path": "outputs/oponent_podklady_revidovane.md",
    "source_materials_sha256": materials_hash,
    "trace_review_status": "accepted",
    "reviewer_role": "independent-opponent-report-trace-reviewer",
    "reviewed_at": "2026-05-07T00:00:01Z",
    "trace_generated_from": ["outputs/oponent_podklady_revidovane.md"],
    "report_calibration_limitation": {
        "type": "no_applicable_profile_or_operator_calibration",
        "calibration_scope": "opponent_report",
        "reviewer_profile_id": "default",
        "assessed_by": "agent",
        "assessor_role": "smoke-trace-reviewer",
        "assessed_at": "2026-05-07T00:00:01Z",
        "profile_sources": profile_sources,
        "operator_calibration_sources": [],
        "rationale": "Smoke fixture records that no case-specific report calibration basis is applied.",
    },
    "is_items": [
        {
            "item_id": item_id,
            "title": title,
            "formulation": formulation,
            "evidence_refs": ["outputs/oponent_podklady_revidovane.md"],
        }
        for item_id, (title, formulation) in formulations.items()
    ],
    "defense_questions": [
        {
            "question_id": "D1",
            "question": "Jak presne lze reprodukovat vysledky z tabulky 2?",
            "evidence_refs": ["outputs/oponent_podklady_revidovane.md"],
        }
    ],
    "pre_submission_checks": [
        {
            "check_id": "C1",
            "instruction": "Zkontrolovat, ze slovni hodnoceni odpovida bodum a znamce.",
            "evidence_refs": ["outputs/oponent_podklady_revidovane.md"],
        }
    ],
    "uncertainty_items": [
        {
            "claim_id": "U1",
            "summary": "Plny runtime nebyl overen.",
            "handling_instruction": "Zachovat opatrnou formulaci v celkovem hodnoceni.",
            "source_refs": ["outputs/oponent_podklady_revidovane.md"],
            "target_section_ids": ["overall_assessment"],
            "report_refs": ["work/oponent_posudek_draft.md"],
            "status": "carried_to_report",
        }
    ],
    "limitations": [],
}
claim_id = "claim-overall"

