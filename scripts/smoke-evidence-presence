#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_id="__evidence_presence_smoke_$$"
round_id="round-a"
round_dir="$repo_root/cases/$case_id/rounds/$round_id"
out_file="/tmp/evidence-presence-smoke.$$.out"
err_file="/tmp/evidence-presence-smoke.$$.err"

cleanup() {
  rm -f "$out_file" "$err_file"
  rm -rf "$repo_root/cases/$case_id"
}
trap cleanup EXIT

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

expect_failure() {
  local name="$1"
  shift
  if "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected failure but passed: $name" >&2
    cat "$out_file" >&2
    exit 1
  fi
}

expect_output() {
  local needle="$1"
  if ! grep -Fq "$needle" "$out_file" "$err_file"; then
    echo "Expected output to contain: $needle" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

mkdir -p "$round_dir/notes" "$round_dir/work" "$round_dir/inputs"
cat >"$repo_root/cases/$case_id/case.md" <<'EOF'
Work type: BP
Academic year: 2025/2026
Student feedback language: cs
Reviewer profile: default
EOF
echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"
cat >"$round_dir/notes/assignment.md" <<'EOF'
# Assignment Context

## Formal Assignment Text Or Summary

- Provide a demo video and presentation.
EOF
printf '%s\n' 'synthetic media' >"$round_dir/inputs/demo.mp4"

expect_failure "missing structured evidence requirements" "$repo_root/scripts/check-evidence-presence" "$case_id"
expect_output "missing structured evidence artifact"

python3 - "$round_dir/work/evidence_requirements.json" "$case_id" "$round_id" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
case_id = sys.argv[2]
round_id = sys.argv[3]
payload = {
    "schema_version": "evidence-requirements-v1",
    "case_id": case_id,
    "round_id": round_id,
    "generated_at": "2026-05-07T00:00:00Z",
    "producer_type": "agent",
    "producer_role": "evidence-requirements-reviewer",
    "producer_agent": "smoke-agent",
    "authorization_note": "Smoke test uses a synthetic agent-authored fixture.",
    "source_refs": ["notes/assignment.md", "inputs/demo.mp4"],
    "requirements": [
        {
            "requirement_id": "E1",
            "category": "media",
            "state": "present",
            "request": "Check demo evidence.",
            "evidence_refs": ["inputs/demo.mp4"],
            "requires_reviewer_verification": False,
        },
        {
            "requirement_id": "E2",
            "category": "evaluation_data",
            "state": "weak",
            "request": "Review evaluation evidence.",
            "evidence_refs": [],
            "requires_reviewer_verification": True,
        },
    ],
    "limitations": [],
}
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY

expect_success "structured evidence requirements" "$repo_root/scripts/check-evidence-presence" "$case_id"
expect_output "Evidence requirements structured artifact check passed"
expect_output "Evidence requirements: 2"
expect_output "Media inventory records: 1"
python3 - "$round_dir/work/evidence_requirements.json" "$round_dir/work/media_presence_inventory.jsonl" <<'PY'
import json
import pathlib
import sys

requirements = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
assert requirements["schema_version"] == "evidence-requirements-v1"
inventory_lines = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").splitlines()
assert len(inventory_lines) == 1, inventory_lines
record = json.loads(inventory_lines[0])
assert record["path"] == "inputs/demo.mp4", record
assert record["state"] == "present-uninspected", record
PY
test ! -f "$round_dir/work/evidence_presence.json"

echo "Evidence presence smoke passed"
