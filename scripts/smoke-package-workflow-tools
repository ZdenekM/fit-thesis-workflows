#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

tmp_output="$(mktemp)"
tmp_dir="$(mktemp -d)"
tmp_repo="$(mktemp -d)"
case_prefix="__package_workflow_tools_smoke_$$"
trap 'rm -f "$tmp_output"; rm -rf "$tmp_dir" "$tmp_repo" "$repo_root/cases/${case_prefix}_relative"' EXIT

scripts/package-workflow-tools >/dev/null
grep -Fq "thesis_review_workflow.cli.package_workflow_tools" "$repo_root/scripts/package-workflow-tools.cmd"
grep -Fq "goto use_py_launcher" "$repo_root/scripts/package-workflow-tools.cmd"
grep -Fq "goto use_python_launcher" "$repo_root/scripts/package-workflow-tools.cmd"
grep -Fq "thesis_review_workflow.cli.package_workflow_tools" "$repo_root/scripts/package-workflow-tools.ps1"
grep -Fq "Get-Command" "$repo_root/scripts/package-workflow-tools.ps1"

mapfile -t tool_names < <(find "$repo_root/dist/workflow-tools/pex" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | sort)

for tool_name in "${tool_names[@]}"; do
  launcher="$repo_root/dist/workflow-tools/bin/$tool_name"
  cmd_launcher="$repo_root/dist/workflow-tools/bin/$tool_name.cmd"
  ps_launcher="$repo_root/dist/workflow-tools/bin/$tool_name.ps1"
  if [[ ! -x "$launcher" ]]; then
    echo "Missing executable launcher: dist/workflow-tools/bin/$tool_name" >&2
    exit 1
  fi
  if [[ ! -f "$cmd_launcher" ]]; then
    echo "Missing Windows cmd launcher: dist/workflow-tools/bin/$tool_name.cmd" >&2
    exit 1
  fi
  if [[ ! -f "$ps_launcher" ]]; then
    echo "Missing Windows PowerShell launcher: dist/workflow-tools/bin/$tool_name.ps1" >&2
    exit 1
  fi
  grep -Fq "WORKFLOW_TOOLS_PYTHON" "$cmd_launcher"
  grep -Fq "PEX_ROOT" "$cmd_launcher"
  grep -Fq "..\\pex\\$tool_name" "$cmd_launcher"
  grep -Fq "WORKFLOW_TOOLS_PYTHON" "$ps_launcher"
  grep -Fq "PEX_ROOT" "$ps_launcher"
  grep -Fq "..\\pex\\$tool_name" "$ps_launcher"
  grep -Fq "Get-Command" "$ps_launcher"
  "$launcher" --help >/dev/null 2>&1
done

(
  cd /tmp
  "$repo_root/dist/workflow-tools/bin/case-doctor" --help >/dev/null 2>&1
)

mkdir -p "$tmp_dir/shadow-pythonpath"
printf '%s\n' 'raise RuntimeError("shadowed subprocess imported")' >"$tmp_dir/shadow-pythonpath/subprocess.py"
env PYTHONPATH="$tmp_dir/shadow-pythonpath" "$repo_root/dist/workflow-tools/bin/case-doctor" --help >/dev/null 2>&1

expect_no_missing_cli_module() {
  if "$@" >"$tmp_output" 2>&1; then
    return
  fi
  if grep -Fq "No module named thesis_review_workflow.cli" "$tmp_output"; then
    echo "Packaged tool is missing a nested CLI module: $*" >&2
    cat "$tmp_output" >&2
    exit 1
  fi
}

printf '%s\n' 'Synthetic assignment summary.' >"$tmp_dir/assignment.txt"
(
  cd "$tmp_dir"
  "$repo_root/dist/workflow-tools/bin/bootstrap-case" opponent "${case_prefix}_relative" relative-round \
    --assignment-summary-file assignment.txt >/dev/null
)
test -f "$repo_root/cases/${case_prefix}_relative/current-round.txt"

mkdir -p "$tmp_repo"/{dist,profiles}
cp -R "$repo_root/dist/workflow-tools" "$tmp_repo/dist/"
cp "$repo_root/profiles/default.md" "$tmp_repo/profiles/default.md"
cp -R "$repo_root/config" "$tmp_repo/config"
cp -R "$repo_root/templates" "$tmp_repo/templates"
git -C "$tmp_repo" init -q
"$tmp_repo/dist/workflow-tools/bin/new-case" "${case_prefix}_sourceless" BP first-review >/dev/null
sourceless_case="$tmp_repo/cases/${case_prefix}_sourceless"
sourceless_round="$(<"$sourceless_case/current-round.txt")"
sourceless_round_dir="$sourceless_case/rounds/$sourceless_round"
test -f "$sourceless_case/current-round.txt"

printf '%s\n' 'relative input outside repo' >"$tmp_dir/relative-input.md"
(
  cd "$tmp_dir"
  "$tmp_repo/dist/workflow-tools/bin/import-round" "${case_prefix}_sourceless" relative-import relative-input.md >/dev/null
)
relative_round="$(<"$sourceless_case/current-round.txt")"
test -f "$sourceless_case/rounds/$relative_round/inputs/relative-input.md"
echo "$sourceless_round" >"$sourceless_case/current-round.txt"

python3 - "$sourceless_case/case.md" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
text = text.replace("Academic year:", "Academic year: 2025/2026")
path.write_text(text, encoding="utf-8")
PY
cat >"$sourceless_round_dir/notes/assignment.md" <<'EOF'
# Assignment

## Formal Assignment Artifacts

- present

## Formal Assignment Text Or Summary

- 2025/2026 assignment summary present

## Private Assignment Notes For Student

- None
EOF
mkdir -p "$sourceless_round_dir/outputs"
cat >"$sourceless_round_dir/outputs/feedback_student.md" <<'EOF'
# Zpětná vazba k aktuální verzi práce

Datum kontroly: 2026-05-05

## Krátké celkové shrnutí

Text má českou diakritiku a konkrétní obsah.

## Rozsah kontroly

- Bez omezení.

## Odhad fáze práce a doporučené zaměření

Text.

## Co se od minulé verze posunulo

Text.

## Co je na práci už dobré

Text.

## Nejvyšší priority pro aktuální iteraci

| priorita | kde se to projevuje | co udělat |
| --- | --- | --- |
| P1 | zadání | doplnit konkrétní kontrolu |

## Splnění zadání

Text.

## Připomínky k textu práce

Text.

## Soulad textu s kódem

Text.

## Co z minulé zpětné vazby zůstává

Text.

## Doporučený plán dalších úprav

Text.

## Checklist pro aktuální fázi

- [ ] Zkontrolovat zadání.
EOF
cat >"$sourceless_round_dir/outputs/oponent_podklady_revidovane.md" <<'EOF'
# Revidovane podklady pro oponentsky posudek

## 1. Rozsah kontroly
## 2. Strucna mapa prace
## 3. Splneni zadani
## 4. Technicke jadro prace vysvetlene oponentovi
## 5. Mapa textu, kodu a artefaktu
## 6. Evidence ledger: hlavni tvrzeni a opora
## 7. Silne stranky
## 8. Hlavni rizika a nedostatky
## 9. Pokryti polozek IS a navrhy formulaci
## 10. Technicka spravnost a realizacni vystup
## 11. Experimenty, vysledky a reprodukovatelnost
## 12. Text, struktura, formalni stranka a literatura
## 13. Orientacni kalibrace hodnoceni
## 14. Navrhy otazek k obhajobe
## 15. Rucni kontroly pred napsanim posudku
EOF
mkdir -p "$sourceless_round_dir/work"
cat >"$sourceless_round_dir/work/oponent_posudek_draft.md" <<'EOF'
# Návrh oponentského posudku

<!-- source_materials_path: outputs/oponent_podklady_revidovane.md -->
<!-- source_materials_sha256: placeholder -->

## 1. Náročnost zadání
## 2. Rozsah splnění požadavků zadání
## 3. Rozsah technické zprávy
## 4. Prezentační úroveň technické zprávy
## 5. Formální úprava technické zprávy
## 6. Práce s literaturou
## 7. Realizační výstup
## 8. Využitelnost výsledku
## 9. Celkové hodnocení
## 10. Otázky k obhajobě
## 11. Body a známka
## 12. Před odevzdáním
EOF

"$tmp_repo/dist/workflow-tools/bin/check-round-ready" "${case_prefix}_sourceless" >/dev/null
"$tmp_repo/dist/workflow-tools/bin/check-supervisor-ready" "${case_prefix}_sourceless" >/dev/null
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/check-review-materiality" \
  --workflow supervisor_feedback "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/prepare-supervisor-packets" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/prepare-opponent-packets" "${case_prefix}_sourceless"
test -f "$sourceless_round_dir/work/supervisor_packets/text_assignment.md"
test -f "$sourceless_round_dir/work/opponent_packets/text_structure_assignment.md"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/case-doctor" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/check-feedback-output" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/check-opponent-materials" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/check-opponent-report" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/draft-opponent-report" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/init-review-manifest" --run-checks "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/check-review-manifest" --require-complete "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/opponent-closeout" "${case_prefix}_sourceless"
expect_no_missing_cli_module "$tmp_repo/dist/workflow-tools/bin/review-round-closeout" \
  --profile supervisor_feedback "${case_prefix}_sourceless"

export_case="${case_prefix}_export"
export_round="round-a"
export_case_dir="$tmp_repo/cases/$export_case"
export_round_dir="$export_case_dir/rounds/$export_round"
mkdir -p "$export_round_dir/notes" "$export_round_dir/outputs" "$export_round_dir/work"
{
  echo "Work type: BP"
  echo "Academic year: 2025/2026"
  echo "Reviewer profile: default"
} >"$export_case_dir/case.md"
echo "$export_round" >"$export_case_dir/current-round.txt"
cat >"$export_round_dir/notes/assignment.md" <<'EOF'
# Assignment

## Formal Assignment Artifacts

- present

## Formal Assignment Text Or Summary

- synthetic assignment summary present

## Private Assignment Notes For Student

- None
EOF
python3 - "$export_round_dir" "$export_case" "$export_round" <<'PY'
import hashlib
import json
import pathlib
import sys

round_dir = pathlib.Path(sys.argv[1])
case_id = sys.argv[2]
round_id = sys.argv[3]

materials = """# Revidovane podklady pro oponentsky posudek

## 1. Rozsah kontroly

Kontrola zahrnula renderovane PDF, extrahovany text, assignment summary, README,
zdrojovy kod v `src/main.py`, vysledkovou tabulku a interni evidence review.
Kod nebyl spusten nad plnymi daty; to je hlavni omezeni kontroly.

## 2. Strucna mapa prace

Prace navrhuje a implementuje prototyp pro zpracovani obrazovych dat.

## 3. Splneni zadani

| Bod zadani | Stav | Evidence | Kalibrace |
|---|---|---|---|
| 1. Study relevant methods | Splneno | Kapitola 2 a bibliography prace. | Bez zasadni vyhrady. |
| 2. Implement prototype | Splneno s vyhradou | README, `main.py` a zadani bod 2. | Dulezite pro realizacni vystup. |
| 3. Evaluate solution | Castecne splneno | Kapitola 5, tabulka 2 a vysledky experimentu. | Slabsi reprodukovatelnost. |

## 4. Technicke jadro prace vysvetlene oponentovi

Technicke jadro tvori klasicka pipeline s vlastni orchestrace zpracovani dat.

## 5. Mapa textu, kodu a artefaktu

| Oblast | Evidence | Stav |
|---|---|---|
| Text prace | `extracted/thesis.txt` a kapitola 2 | Dostupne. |
| Kod | `src/main.py` a README | Inspektovatelne. |

## 6. Evidence ledger: hlavni tvrzeni a opora

| Tvrzeni | Znacka jistoty | Opora | Dopad na posudek | Pouzit do posudku? |
|---|---|---|---|---|
| Student implementoval vlastni prototyp. | [FAKT] | README, `main.py` a kapitola 4. | Pozitivni realizacni bod. | Ano. |
| Vyhodnoceni je vecne relevantni, ale omezeně reprodukovatelne. | [INTERPRETACE] | Kapitola 5, tabulka 2 a chybejici metricke skripty. | Stredni vyhrada. | Ano. |
| Plny runtime nebyl overen. | [NEOVERENO] | Scope section a chybejici smoke dataset. | Nutna opatrnost ve formulaci. | Ano. |

## 7. Silne stranky

- Prace ma konkretni implementacni vystup dolozeny README a zdrojovym kodem.
- Text obsahuje smysluplnou strukturu od metod po vysledky.

## 8. Hlavni rizika a nedostatky

| Priorita | Tvrzeni | Evidence | Dopad | Mozna formulace do posudku |
|---|---|---|---|---|
| P1 | Reprodukovatelnost vysledku neni primo pripravena. | README, kapitola 5 a chybejici metricke skripty. | Snizuje overitelnost. | "Vysledky nejsou z dodanych zdroju snadno reprodukovatelne." |

## 9. Pokryti polozek IS a navrhy formulaci

| Polozka IS | Stav | Evidence | Dopad | Mozna formulace |
|---|---|---|---|---|
| Narocnost zadani | Stredni | Zadani a technicke metody. | Korekcni faktor. | "Zadani hodnotim jako stredne narocne." |
| Rozsah splneni zadani | Splneno s vyhradou | Zadani bod 2 a kapitola 4. | Vyssi. | "Zadani bylo naplneno s vyhradami." |
| Rozsah technicke zpravy | Dostatecny | Kapitoly 2 az 5. | Stredni. | "Zprava pokryva hlavni principy." |
| Prezentacni uroven | Dobra | Struktura textu a tabulka 2. | Stredni. | "Text je prevazne citelny." |
| Formalni uprava | Bez zasadniho nalezu | PDF a tabulky. | Nizky. | "Formalni stranka neni hlavni slabina." |
| Prace s literaturou | Relevantni s rezervou | Bibliography a kapitola 2. | Stredni. | "Literatura je relevantni, ale mohla byt vice vyuzita." |
| Realizacni vystup | Funkcni prototyp | README, `main.py` a vysledky. | Vyssi. | "Realizace je funkcni prototyp." |
| Vyuzitelnost vysledku | Orientacni prototyp | Zaver a vysledkova kapitola. | Stredni. | "Vysledek je vyuzitelny hlavne jako prototyp." |
| Celkove hodnoceni | Dobre az velmi dobre | Kombinace zadani, kodu a vysledku. | Synteticke. | "Celkove jde o obhajitelny BP vystup." |

## 10. Technicka spravnost a realizacni vystup

Text-code consistency je v zakladnich tvrzenich dobra.

## 11. Experimenty, vysledky a reprodukovatelnost

Experimenty jsou tematicky vhodne a maji konkretni tabulkove vysledky.

## 12. Text, struktura, formalni stranka a literatura

Text je strukturovany a obhajitelny.

## 13. Orientacni kalibrace hodnoceni

- Konzervativni interval: 70-76 bodu, pokud bude hlavni vaha na reprodukovatelnosti.
- Standardni interval: 76-82 bodu, pokud se oceni funkcni prototyp a priznana omezeni.

Nejlepe obhajitelny interval je 76-82 bodu.

## 14. Navrhy otazek k obhajobe

1. Jak presne lze reprodukovat vysledky z tabulky 2?
2. Co by bylo potreba doplnit, aby byl prototyp robustnejsi?
3. Ktere casti reseni jsou vase vlastni a ktere primo zavisi na knihovnich metodach?

## 15. Rucni kontroly pred napsanim posudku

- Spustit maly smoke test nad pripravenym datasetem a zaznamenat vysledek.
- Otevrit vysledkove obrazky a porovnat je s tabulkou 2.
"""
materials_path = round_dir / "outputs" / "oponent_podklady_revidovane.md"
materials_path.write_text(materials, encoding="utf-8")
materials_hash = hashlib.sha256(materials_path.read_bytes()).hexdigest()

trace = {
    "schema_version": "opponent-report-trace-v1",
    "case_id": case_id,
    "round_id": round_id,
    "generated_at": "2026-05-18T00:00:00Z",
    "producer_type": "agent",
    "producer_role": "opponent-report-trace-reviewer",
    "producer_agent": "package-smoke-trace-agent",
    "authorization_note": "Package smoke uses a synthetic agent-authored fixture.",
    "source_refs": ["outputs/oponent_podklady_revidovane.md"],
    "source_materials_path": "outputs/oponent_podklady_revidovane.md",
    "source_materials_sha256": materials_hash,
    "trace_review_status": "accepted",
    "reviewer_role": "independent-opponent-report-trace-reviewer",
    "reviewed_at": "2026-05-18T00:00:01Z",
    "trace_generated_from": ["outputs/oponent_podklady_revidovane.md"],
    "is_items": [
        {"item_id": item_id, "title": title, "formulation": "Text.", "evidence_refs": ["outputs/oponent_podklady_revidovane.md"]}
        for item_id, title in [
            ("assignment_difficulty", "Náročnost zadání"),
            ("assignment_fulfillment", "Rozsah splnění požadavků zadání"),
            ("technical_report_scope", "Rozsah technické zprávy"),
            ("technical_report_presentation", "Prezentační úroveň technické zprávy"),
            ("technical_report_formal_level", "Formální úprava technické zprávy"),
            ("literature_work", "Práce s literaturou"),
            ("implementation_output", "Realizační výstup"),
            ("result_usability", "Využitelnost výsledku"),
            ("overall_assessment", "Celkové hodnocení"),
        ]
    ],
    "defense_questions": [
        {"question_id": "D1", "question": "Jak lze vysledky reprodukovat?", "evidence_refs": ["outputs/oponent_podklady_revidovane.md"]}
    ],
    "pre_submission_checks": [
        {"check_id": "C1", "instruction": "Zkontrolovat body a znamku.", "evidence_refs": ["outputs/oponent_podklady_revidovane.md"]}
    ],
    "uncertainty_items": [],
    "limitations": [],
}
trace_path = round_dir / "work" / "opponent_report_trace.json"
trace_path.write_text(json.dumps(trace, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
trace_hash = hashlib.sha256(trace_path.read_bytes()).hexdigest()

draft = f"""<!-- source_trace_path: work/opponent_report_trace.json -->
<!-- source_trace_sha256: {trace_hash} -->
<!-- source_materials_path: outputs/oponent_podklady_revidovane.md -->
<!-- source_materials_sha256: {materials_hash} -->
# Návrh oponentského posudku

Datum přípravy draftu: 2026-05-18T00:00:00Z
Stav: připraveno pro nezávislou kontrolu oponentem.

## IS formulář (výběry a body)

Náročnost zadání: obtížnější zadání
Rozsah splnění požadavků zadání: zadání splněno s drobnými výhradami
Rozsah technické zprávy: je v obvyklém rozmezí
Prezentační úroveň technické zprávy: 80 bodů
Formální úprava technické zprávy: 80 bodů
Práce s literaturou: 80 bodů
Realizační výstup: 80 bodů

## 1. Náročnost zadání

Text.

## 2. Rozsah splnění požadavků zadání

Text.

## 3. Rozsah technické zprávy

Text.

## 4. Prezentační úroveň technické zprávy

Text.

## 5. Formální úprava technické zprávy

Text.

## 6. Práce s literaturou

Text.

## 7. Realizační výstup

Text.

## 8. Využitelnost výsledku

Text.

## 9. Celkové hodnocení

Text.

## 10. Otázky k obhajobě

- Jak lze vysledky reprodukovat?

## 11. Body a známka

Body: 80
Známka: B

## Komentář pro studenta (neveřejná část)

Děkuji za zpracovanou práci. Silnou stránkou je funkční prototyp a přiměřené pokrytí zadání.
K obhajobě doporučuji připravit konkrétní metodiku testování, stručnou ukázku výsledků
a jasné oddělení vlastního přínosu od použitých knihoven.

## 12. Před odevzdáním

- Zkontrolovat, ze slovni hodnoceni odpovida bodum a znamce.
"""
(round_dir / "work" / "oponent_posudek_draft.md").write_text(draft, encoding="utf-8")
PY
"$tmp_repo/dist/workflow-tools/bin/export-opponent-report" "$export_case" "$export_round" >/dev/null
test -f "$export_round_dir/outputs/oponent_posudek_navrh.md"
grep -Fq "## IS formulář (výběry a body)" "$export_round_dir/outputs/oponent_posudek_navrh.md"
if grep -Fq "source_trace_path" "$export_round_dir/outputs/oponent_posudek_navrh.md"; then
  echo "Packaged export leaked source metadata" >&2
  exit 1
fi

if WORKFLOW_TOOLS_PYTHON=/bin/false "$repo_root/dist/workflow-tools/bin/check-tooling" --help >"$tmp_output" 2>&1; then
  echo "Python version guard unexpectedly passed with WORKFLOW_TOOLS_PYTHON=/bin/false" >&2
  exit 1
fi

if ! grep -Fq "Workflow tool launchers require Python 3.12" "$tmp_output"; then
  echo "Python version guard did not print the expected diagnostic" >&2
  cat "$tmp_output" >&2
  exit 1
fi

echo "Workflow tool package smoke passed"
