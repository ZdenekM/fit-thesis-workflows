#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"
case_id="__smoke_submission_bundle_materialization__"
round_id="20260519-smoke"
case_dir="$repo_root/cases/$case_id"
round_dir="$case_dir/rounds/$round_id"

cleanup() {
  rm -rf "$case_dir"
}
trap cleanup EXIT
cleanup

mkdir -p "$round_dir/inputs" "$round_dir/notes" "$round_dir/extracted" "$round_dir/work" "$round_dir/outputs"
cat >"$case_dir/case.md" <<'EOF'
Work type: BP
Academic year: 2025/2026
Student feedback language: cs
Thesis language: auto
Reviewer profile: default
EOF
printf '%s\n' "$round_id" >"$case_dir/current-round.txt"
cat >"$round_dir/notes/assignment.md" <<'EOF'
# Assignment

## Formal Assignment Artifacts
- synthetic assignment source

## Formal Assignment Text Or Summary
Synthetic assignment summary.

## Private Assignment Notes For Student
Synthetic private note.
EOF

python3 - "$round_dir/inputs/submission.zip" <<'PY'
import io
import sys
import zipfile

target = sys.argv[1]
code = io.BytesIO()
with zipfile.ZipFile(code, "w") as handle:
    handle.writestr("project/pyproject.toml", "[project]\nname = 'synthetic'\n")
    handle.writestr("project/src/main.py", "print('synthetic')\n")
with zipfile.ZipFile(target, "w") as handle:
    handle.writestr("handoff/code.zip", code.getvalue())
    handle.writestr("handoff/assignment-zadani.pdf", b"%PDF-1.4\n")
    handle.writestr("handoff/demo.mp4", b"mp4 placeholder")
    handle.writestr("handoff/app.apk", b"apk placeholder")
PY

"$repo_root/scripts/review-round-start" "$case_id" "$round_id" \
  --profile opponent_materials \
  --submission-bundle inputs/submission.zip \
  --bundle-classification container_bundle \
  --bundle-child inputs/materialized-code.zip >/tmp/submission-bundle-start-smoke.out

candidate_id="$(
  python3 - "$round_dir/work/submission_bundle_inventory.json" <<'PY'
import json
import sys

payload = json.loads(open(sys.argv[1], encoding="utf-8").read())
media_seen = False
executable_seen = False
code_id = None
for candidate in payload["candidates"]:
    if candidate["artifact_class"] in {"media_artifact", "executable_artifact"}:
        metadata = candidate["deterministic_metadata"]
        assert metadata["metadata_mode"] == "non_executing_structural_metadata", metadata
        assert metadata["semantic_observation"] == "not_performed", metadata
        assert metadata["execution_state"] == "not_run", metadata
        assert "sha256" in metadata, metadata
        media_seen = media_seen or candidate["artifact_class"] == "media_artifact"
        executable_seen = executable_seen or candidate["artifact_class"] == "executable_artifact"
    if candidate["artifact_class"] == "code_archive_candidate" and code_id is None:
        code_id = candidate["candidate_id"]
if code_id is None:
    raise SystemExit("missing code archive candidate")
assert media_seen, "missing media metadata"
assert executable_seen, "missing executable metadata"
print(code_id)
PY
)"

"$repo_root/scripts/materialize-submission-bundle-candidate" \
  "$case_id" \
  "$round_id" \
  --candidate-id "$candidate_id" \
  --output inputs/materialized-code.zip \
  --generated-at 2026-05-19T12:00:00Z >/tmp/submission-bundle-materialize-smoke.out

"$repo_root/scripts/review-round-start" "$case_id" "$round_id" \
  --profile opponent_materials \
  --submission-bundle inputs/submission.zip \
  --bundle-classification container_bundle \
  --bundle-child inputs/materialized-code.zip \
  --code-archive inputs/materialized-code.zip >/tmp/submission-bundle-rerun-smoke.out

"$repo_root/scripts/prepare-code-workspace" "$case_id" "$round_id" >/tmp/submission-bundle-code-smoke.out
"$repo_root/scripts/prepare-review-round" \
  "$case_id" \
  "$round_id" \
  --skip-materiality-check >/tmp/submission-bundle-prepare-review-smoke.out
"$repo_root/scripts/opponent-preflight" \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-preflight-smoke.out
"$repo_root/scripts/case-doctor" \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-doctor-smoke.out

test -f "$round_dir/inputs/materialized-code.zip"
test -f "$round_dir/work/submission_bundle_materialization.json"
test -f "$round_dir/work/code/materialized-code/project/src/main.py"
test -f "$round_dir/work/review_role_plan.json"
grep -Fq "Submission Bundle Inventory" /tmp/submission-bundle-preflight-smoke.out
grep -Fq "Demo/media/executables:" /tmp/submission-bundle-preflight-smoke.out
grep -Fq "executable_artifact" /tmp/submission-bundle-preflight-smoke.out
grep -Fq "expected extract \`extracted/submission_bundle/" /tmp/submission-bundle-preflight-smoke.out
grep -Fq "Submission Bundle Inventory" /tmp/submission-bundle-doctor-smoke.out
grep -Fq "First-party-looking code:" /tmp/submission-bundle-doctor-smoke.out
grep -Fq "work/submission_bundle_inventory.json" "$round_dir/work/common_briefing.json"
grep -Fq "Submission Bundle Inventory" "$round_dir/work/opponent_packets/text_structure_assignment.md"

assignment_candidate_id="$(
  python3 - "$round_dir/work/submission_bundle_inventory.json" <<'PY'
import json
import sys

payload = json.loads(open(sys.argv[1], encoding="utf-8").read())
for candidate in payload["candidates"]:
    if candidate["artifact_class"] == "assignment_pdf_candidate":
        print(candidate["candidate_id"])
        break
else:
    raise SystemExit("missing assignment PDF candidate")
PY
)"

"$repo_root/scripts/materialize-submission-bundle-candidate" \
  "$case_id" \
  "$round_id" \
  --candidate-id "$assignment_candidate_id" \
  --output inputs/assignment-zadani.pdf \
  --generated-at 2026-05-19T12:01:00Z >/tmp/submission-bundle-assignment-materialize-smoke.out

test -f "$round_dir/inputs/assignment-zadani.pdf"

media_candidate_id="$(
  python3 - "$round_dir/work/submission_bundle_inventory.json" <<'PY'
import json
import sys

payload = json.loads(open(sys.argv[1], encoding="utf-8").read())
for candidate in payload["candidates"]:
    if candidate["artifact_class"] == "media_artifact":
        print(candidate["candidate_id"])
        break
else:
    raise SystemExit("missing media candidate")
PY
)"

"$repo_root/scripts/materialize-submission-bundle-candidate" \
  "$case_id" \
  "$round_id" \
  --candidate-id "$media_candidate_id" \
  --output inputs/demo.mp4 \
  --generated-at 2026-05-19T12:01:30Z >/tmp/submission-bundle-media-materialize-smoke.out

"$repo_root/scripts/update-current-evidence-snapshot" \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-current-evidence-smoke.out
"$repo_root/scripts/refresh-round-hashes" \
  --generated-at 2026-05-19T12:02:00Z \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-refresh-smoke.out
"$repo_root/scripts/prepare-review-round" \
  "$case_id" \
  "$round_id" \
  --skip-materiality-check >/tmp/submission-bundle-reprepare-review-smoke.out
"$repo_root/scripts/init-review-manifest" \
  --run-checks \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-manifest-smoke.out
"$repo_root/scripts/check-review-manifest" \
  --require-complete \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-check-manifest-smoke.out

python3 - "$round_dir/work/submission_bundle_materialization.json" <<'PY'
import json
import sys

payload = json.loads(open(sys.argv[1], encoding="utf-8").read())
records = {record["materialized_ref"]: record for record in payload["materializations"]}
assert records["inputs/materialized-code.zip"]["source_bundle_ref"] == "inputs/submission.zip"
assert records["inputs/materialized-code.zip"]["nested_path_chain"] == ["handoff/code.zip"]
assert records["inputs/assignment-zadani.pdf"]["nested_path_chain"] == ["handoff/assignment-zadani.pdf"]
PY

python3 - "$round_dir" <<'PY'
import hashlib
import json
import pathlib
import sys

round_dir = pathlib.Path(sys.argv[1])
manifest = json.loads((round_dir / "work/review_manifest.json").read_text(encoding="utf-8"))
support = {item["path"]: item for item in manifest["supporting_work_artifacts"]}
for rel in (
    "work/submission_bundle_inventory.json",
    "work/submission_bundle_inventory.md",
    "work/submission_bundle_materialization.json",
):
    assert rel in support, rel
    digest = hashlib.sha256((round_dir / rel).read_bytes()).hexdigest()
    assert support[rel]["artifact_sha256"] == digest, rel
inputs = {item["path"] for item in manifest["inputs"]}
assert "inputs/materialized-code.zip" in inputs
assert "inputs/assignment-zadani.pdf" in inputs
assert "inputs/demo.mp4" in inputs
snapshot = json.loads((round_dir / "work/current_evidence_snapshot.json").read_text(encoding="utf-8"))
snapshot_refs = {item["path"] for item in snapshot["items"]}
assert "work/submission_bundle_inventory.json" in snapshot_refs
assert "work/submission_bundle_materialization.json" in snapshot_refs
assert not (round_dir / "extracted/submission_bundle").exists()
PY

cat >"$round_dir/work/evidence_requirements.json" <<'JSON'
{
  "schema_version": "evidence-requirements-v1",
  "case_id": "__smoke_submission_bundle_materialization__",
  "round_id": "20260519-smoke",
  "generated_at": "2026-05-19T12:03:15Z",
  "producer_type": "human",
  "producer_role": "smoke",
  "producer_agent": "",
  "human_reviewer_note": "Synthetic smoke requirement for media-presence metadata only.",
  "authorization_note": "Synthetic smoke fixture.",
  "source_refs": [
    "inputs/demo.mp4"
  ],
  "requirements": [
    {
      "requirement_id": "media-demo",
      "category": "media",
      "state": "present",
      "request": "Synthetic demo artifact is structurally present.",
      "evidence_refs": [
        "inputs/demo.mp4"
      ],
      "requires_reviewer_verification": true
    }
  ],
  "limitations": [
    "Synthetic smoke records metadata only; media content is not semantically inspected."
  ]
}
JSON
inventory_before_media_check="$(sha256sum "$round_dir/work/submission_bundle_inventory.json" | awk '{print $1}')"
"$repo_root/scripts/check-evidence-presence" \
  "$case_id" \
  "$round_id" >/tmp/submission-bundle-evidence-presence-smoke.out
inventory_after_media_check="$(sha256sum "$round_dir/work/submission_bundle_inventory.json" | awk '{print $1}')"
test "$inventory_before_media_check" = "$inventory_after_media_check"
python3 - "$round_dir/work/media_presence_inventory.jsonl" <<'PY'
import json
import pathlib
import sys

records = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()]
record = next(item for item in records if item["path"] == "inputs/demo.mp4")
metadata = record["deterministic_metadata"]
assert metadata["metadata_mode"] == "non_executing_structural_metadata", metadata
assert metadata["semantic_observation"] == "not_performed", metadata
assert metadata["execution_state"] == "not_run", metadata
assert metadata["extension"] == ".mp4", metadata
PY
inventory_before_observation="$(sha256sum "$round_dir/work/submission_bundle_inventory.json" | awk '{print $1}')"
mkdir -p "$round_dir/work/figure_media"
cat >"$round_dir/work/figure_media/visual_inventory.jsonl" <<'JSONL'
{"item_id":"demo-video-structural-note","type":"media","pdf_anchor":"not applicable","caption_or_nearby_claim":"Synthetic smoke demo artifact.","source_asset_path":"inputs/demo.mp4","inspection_status":"inventoried_only","visual_description":"Media content was not inspected; this is a separate observation placeholder.","limitations":"Synthetic smoke only verifies that observation artifacts stay separate from bundle inventory.","downstream_relevance":"Optional media observation artifact remains outside bundle classification."}
JSONL
inventory_after_observation="$(sha256sum "$round_dir/work/submission_bundle_inventory.json" | awk '{print $1}')"
test "$inventory_before_observation" = "$inventory_after_observation"
test -f "$round_dir/work/figure_media/visual_inventory.jsonl"

echo "submission bundle materialization smoke passed"
