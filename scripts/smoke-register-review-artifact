#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
case_id="__register_review_artifact_smoke_$$"
round_id="round-a"
round_dir="$repo_root/cases/$case_id/rounds/$round_id"
out_file="/tmp/register-review-artifact-smoke.$$.out"
err_file="/tmp/register-review-artifact-smoke.$$.err"

cleanup() {
  rm -f "$out_file" "$err_file"
  rm -rf "$repo_root/cases/$case_id"
}
trap cleanup EXIT

expect_success() {
  local name="$1"
  shift
  if ! "$@" >"$out_file" 2>"$err_file"; then
    echo "Expected success but failed: $name" >&2
    cat "$out_file" >&2
    cat "$err_file" >&2
    exit 1
  fi
}

mkdir -p "$round_dir/outputs" "$round_dir/work/opponent_packets"
cat >"$repo_root/cases/$case_id/case.md" <<'EOF'
Work type: BP
Academic year: 2025/2026
Student feedback language: cs
Reviewer profile: default
EOF
echo "$round_id" >"$repo_root/cases/$case_id/current-round.txt"

cat >"$round_dir/outputs/code_quality_review.md" <<'EOF'
# Internal Code Quality Review
EOF
cat >"$round_dir/outputs/oponent_podklady_revidovane.md" <<'EOF'
# Revidovane podklady pro oponentsky posudek
EOF
cat >"$round_dir/outputs/reference_report_comparison.md" <<'EOF'
# Reference Report Comparison
EOF
cat >"$round_dir/outputs/opponent_reading_packet.md" <<'EOF'
# Opponent Reading Packet
EOF
cat >"$round_dir/work/oponent_podklady_draft.md" <<'EOF'
# Podklady pro oponentsky posudek
EOF
cat >"$round_dir/work/opponent_packets/code_quality_findings.md" <<'EOF'
# Code Quality Findings
EOF

expect_success "register final reviewed artifact" "$repo_root/scripts/register-review-artifact" \
  "$case_id" "$round_id" "outputs/oponent_podklady_revidovane.md" \
  --role thesis-opponent-materials \
  --agent generator-agent \
  --review-scope standalone_final \
  --review-status reviewed \
  --reviewer-role thesis-opponent-materials-review \
  --reviewer-agent reviewer-agent \
  --reviewed-at 2026-05-06T00:00:00Z \
  --limitation "None." \
  --review-basis-path work/oponent_podklady_draft.md

expect_success "register output artifact" "$repo_root/scripts/register-review-artifact" \
  "$case_id" "$round_id" "outputs/code_quality_review.md" \
  --agent generator-agent \
  --limitation "Static review only." \
  --feeds outputs/oponent_podklady_revidovane.md \
  --used-findings "Used implementation risk summary." \
  --ref notes/assignment.md \
  --notes "Registered by smoke."

expect_success "register work artifact" "$repo_root/scripts/register-review-artifact" \
  "$case_id" "$round_id" "work/opponent_packets/code_quality_findings.md" \
  --role code-quality-reviewer \
  --agent packet-agent \
  --review-scope internal_only \
  --limitation "Feeds synthesis only." \
  --feeds outputs/oponent_podklady_revidovane.md

expect_success "register reference comparison" "$repo_root/scripts/register-review-artifact" \
  "$case_id" "$round_id" "outputs/reference_report_comparison.md" \
  --role historical-opponent-calibration \
  --agent comparison-generator \
  --review-scope internal_only \
  --review-status reviewed \
  --reviewer-role anti-overfit-reviewer \
  --reviewer-agent comparison-reviewer \
  --reviewed-at 2026-05-06T00:10:00Z \
  --limitation "Synthetic comparison only." \
  --evidence-ref outputs/oponent_podklady_revidovane.md \
  --handoff-ref work/opponent_packets/code_quality_findings.md \
  --used-findings "Used only current-case supported calibration differences." \
  --notes "Registered by smoke."

expect_success "register reading packet" "$repo_root/scripts/register-review-artifact" \
  "$case_id" "$round_id" "outputs/opponent_reading_packet.md" \
  --role historical-opponent-calibration \
  --agent packet-generator \
  --review-scope internal_only \
  --review-status reviewed \
  --reviewer-role anti-overfit-reviewer \
  --reviewer-agent packet-reviewer \
  --reviewed-at 2026-05-06T00:11:00Z \
  --limitation "Synthetic reading packet only." \
  --evidence-ref outputs/reference_report_comparison.md \
  --used-findings "Used reviewed comparison and current-case evidence only." \
  --notes "Registered by smoke."

"$repo_root/scripts/init-review-manifest" "$case_id" "$round_id" >/dev/null

python3 - "$round_dir/work/review_manifest.json" <<'PY'
import json
import pathlib
import sys

manifest_path = pathlib.Path(sys.argv[1])
round_dir = manifest_path.parents[1]
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
output = next(item for item in manifest["artifacts"] if item["path"] == "outputs/code_quality_review.md")
assert output["independent_review"]["status"] == "not_required", output
assert output["generated_by"][0]["agent"] == "generator-agent", output
assert output["generated_by"][0]["role"] == "thesis-code-quality-review", output
assert output["independent_review"]["evidence_hash"] == output["artifact_sha256"], output
assert output["input_refs"] == ["notes/assignment.md"], output
final = next(item for item in manifest["artifacts"] if item["path"] == "outputs/oponent_podklady_revidovane.md")
assert final["independent_review"]["review_basis_path"] == "work/oponent_podklady_draft.md", final
assert final["independent_review"]["review_basis_sha256"], final
comparison = next(item for item in manifest["artifacts"] if item["path"] == "outputs/reference_report_comparison.md")
assert comparison["artifact_type"] == "reference_report_comparison", comparison
assert comparison["review_scope"] == "internal_only", comparison
assert comparison["independent_review"]["status"] == "reviewed", comparison
assert comparison["independent_review"]["reviewed_hash"] == comparison["artifact_sha256"], comparison
assert comparison["independent_review"]["reviewer_agent"] == "comparison-reviewer", comparison
assert "outputs/oponent_podklady_revidovane.md" in comparison["evidence_refs"], comparison
assert "work/opponent_packets/code_quality_findings.md" in comparison["handoff_refs"], comparison
assert comparison["source_sha256"]["outputs/oponent_podklady_revidovane.md"], comparison
assert "work/opponent_packets/code_quality_findings.md" not in comparison["source_sha256"], comparison
packet = next(item for item in manifest["artifacts"] if item["path"] == "outputs/opponent_reading_packet.md")
assert packet["artifact_type"] == "opponent_reading_packet", packet
assert packet["review_scope"] == "internal_only", packet
assert packet["independent_review"]["status"] == "reviewed", packet
assert packet["independent_review"]["reviewed_hash"] == packet["artifact_sha256"], packet
assert packet["independent_review"]["reviewer_agent"] == "packet-reviewer", packet
assert "outputs/reference_report_comparison.md" in packet["evidence_refs"], packet
assert packet["source_sha256"]["outputs/reference_report_comparison.md"], packet
work = next(
    item
    for item in manifest["supporting_work_artifacts"]
    if item["path"] == "work/opponent_packets/code_quality_findings.md"
)
assert work["role"] == "code-quality-reviewer", work
assert work["agent"] == "packet-agent", work
assert work["limitations"] == ["Feeds synthesis only."], work
PY

echo "Register review artifact smoke passed"
